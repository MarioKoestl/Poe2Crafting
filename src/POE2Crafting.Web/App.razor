<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POE2 Crafting Simulator</title>
    <base href="/" />
    <link rel="stylesheet" href="@Versioned("css/site.css")" />
    <HeadOutlet @rendermode="RenderMode" />
</head>
<body>
    <Routes @rendermode="RenderMode" />
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
    <script src="@Versioned("js/site.js")"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@inject IWebHostEnvironment Env

@code {
    /// <summary>No prerendering: the per-user session (projects on disk) is created once, when the interactive circuit starts.</summary>
    private static readonly IComponentRenderMode RenderMode = new InteractiveServerRenderMode(prerender: false);

    /// <summary>The file's URL with its change time as version: after an update the browser loads the new file instead of a cached one.</summary>
    private string Versioned(string path) =>
        Env.WebRootFileProvider.GetFileInfo(path) is { Exists: true } file ? $"{path}?v={file.LastModified.UtcTicks}" : path;
}
