@* Well of Souls: reveal the unrevealed desecrated modifiers of the current item. *@
@inherits ChangingComponentBase
@inject CraftingSession Session

@if (Session.CurrentItem is { } item && item.UnrevealedMods.Any())
{
    <div class="side-section">
        <h3 class="pane-title">Well of Souls</h3>
        <label class="checkbox-row" title="Omen of Abyssal Echoes: the reveal options can be rerolled once">
            <input type="checkbox" @bind="_echoes" /> <CraftItemLink Name="Omen of Abyssal Echoes" /> active
        </label>

        @foreach (var (mod, index) in item.UnrevealedMods.ToList())
        {
            var idx = index;
            var options = Session.RevealOptions(idx);
            var showPool = _showPool.Contains(idx);
            <div class="distribution-section" @key="idx">
                <h4>
                    @mod.DisplayText()
                    <span class="mod-count">@RevealSummary(mod)</span>
                </h4>

                @if (options == null)
                {
                    <button class="btn btn-primary" @onclick="() => Change(() => Session.RollRevealOptions(idx))">Reveal (roll options)</button>
                }
                else
                {
                    <div class="addition-list">
                        @foreach (var option in options)
                        {
                            <ModOptionRow @key="option.Id" Mod="option" Item="item" OnChoose="() => Change(() => Session.Reveal(idx, option.Id))" />
                        }
                    </div>
                    @if (_echoes && Session.CanRerollReveal(idx))
                    {
                        <button class="btn btn-sm" @onclick="() => Change(() => Session.RerollRevealOptions(idx))">Reroll options (Abyssal Echoes)</button>
                    }
                }

                <button class="btn btn-sm" @onclick="() => _showPool.Toggle(idx)">@(showPool ? "Hide" : "Show") full pool / choose any</button>
                @if (showPool)
                {
                    <div class="addition-list">
                        @foreach (var c in Session.Engine.RevealPool(item, idx))
                        {
                            <ModOptionRow @key="c.Mod.Id" Mod="c.Mod" Item="item" Probability="c.Probability" OnChoose="() => Change(() => Session.Reveal(idx, c.Mod.Id))" />
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private bool _echoes;
    private readonly HashSet<int> _showPool = new();

    private static string RevealSummary(ItemMod mod)
    {
        var text = string.Join(", ", new[] { mod.SourceName, mod.Reveal?.Describe() }.Where(p => !string.IsNullOrEmpty(p)));
        return text.Length > 0 ? $"({text})" : "";
    }
}
