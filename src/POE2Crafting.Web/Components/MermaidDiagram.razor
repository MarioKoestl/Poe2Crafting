@inject IJSRuntime JS

<div class="mermaid-container">
    <div @ref="_container" class="mermaid-render"></div>
    @if (_loading)
    {
        <div class="mermaid-loading">Rendering diagram…</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mermaid-error">@_error</div>
    }
</div>

@code {
    [Parameter] public string Definition { get; set; } = "";
    [Parameter] public string? DiagramId { get; set; }

    private ElementReference _container;
    private string _lastRendered = "";
    private bool _loading;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(Definition)) return;

        if (Definition != _lastRendered)
        {
            _loading = true;
            _error = null;
            StateHasChanged();

            try
            {
                var id = DiagramId ?? $"mermaid-{Guid.NewGuid():N}";
                await JS.InvokeVoidAsync("renderMermaid", _container, Definition, id);
                _lastRendered = Definition;
            }
            catch (Exception ex)
            {
                _error = $"Diagram render failed: {ex.Message}";
            }
            finally
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }
}
