@* Renders a Mermaid flowchart definition via site.js renderMermaid (once per definition). *@
@inject IJSRuntime JS

<div class="mermaid-container">
    <div @ref="_container" class="mermaid-render"></div>
    @if (_rendering)
    {
        <div class="mermaid-loading">Rendering diagram…</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mermaid-error">@_error</div>
    }
</div>

@code {
    [Parameter] public string Definition { get; set; } = "";
    [Parameter] public string? DiagramId { get; set; }

    private ElementReference _container;
    /// <summary>The definition that was rendered (or attempted): never rendered twice, also not after an error.</summary>
    private string _attempted = "";
    private bool _rendering;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(Definition) || Definition == _attempted || _rendering) return;
        _attempted = Definition;
        _rendering = true;
        _error = null;
        try
        {
            await JS.InvokeVoidAsync("renderMermaid", _container, Definition, DiagramId ?? $"mermaid-{Guid.NewGuid():N}");
        }
        catch (JSException ex)
        {
            _error = $"Diagram render failed: {ex.Message}";
        }
        finally
        {
            _rendering = false;
            StateHasChanged();
        }
    }
}
