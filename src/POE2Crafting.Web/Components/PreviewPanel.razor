@inject CraftingSession Session

<div class="preview-panel">
    @{
        var preview = Session.Preview(Action);
    }

    <h3>@Action.DisplayName</h3>

    @* Currency description *@
    @if (Action.Currency.Description.Count > 0)
    {
        <div class="currency-description">
            @foreach (var line in Action.Currency.Description)
            {
                <p>@line</p>
            }
        </div>
    }

    @if (!preview.Applicability.Ok)
    {
        <div class="error-banner">@preview.Applicability.Reason</div>
    }
    else
    {
        @* Notes / Assumptions *@
        @if (preview.Notes.Count > 0)
        {
            <div class="notes-section">
                @foreach (var note in preview.Notes)
                {
                    <div class="note">@note</div>
                }
            </div>
        }

        @* Removal distribution *@
        @if (preview.Removals.Count > 0)
        {
            <div class="distribution-section">
                <h4>@(preview.RemoveCount > 0 ? $"Removal ({preview.RemoveCount}x)" : "Fracture Target")</h4>
                <div class="distribution-list">
                    @foreach (var r in preview.Removals.OrderByDescending(x => x.Probability))
                    {
                        <div class="dist-row">
                            <div class="dist-bar-bg">
                                <div class="dist-bar removal" style="width: @($"{r.Probability * 100:F1}")%"></div>
                            </div>
                            <span class="dist-pct">@($"{r.Probability:P1}")</span>
                            <span class="dist-label">@r.Mod.DisplayText()</span>
                            @if (_manualMode)
                            {
                                <button class="btn btn-xs" @onclick="() => ChooseRemoval(r.Index)">Choose</button>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Addition distribution — poe2db style *@
        @if (preview.Additions.Count > 0)
        {
            <div class="distribution-section">
                <h4>Addition (@(preview.AddCount)x) — P(@($"{preview.PrefixProbability:P0}")) / S(@($"{preview.SuffixProbability:P0}"))</h4>
                <div class="addition-list">
                    @{
                        var sorted = preview.Additions
                            .OrderByDescending(c => c.Probability)
                            .Take(_showAll ? int.MaxValue : 20)
                            .ToList();
                    }
                    @foreach (var c in sorted)
                    {
                        <div class="add-row @(c.Mod.IsPrefix ? "prefix-row" : "suffix-row")">
                            <span class="add-pct">@($"{c.Probability * 100:F2}") %</span>
                            <span class="add-type @(c.Mod.IsPrefix ? "type-prefix" : "type-suffix")">@(c.Mod.IsPrefix ? "P" : "S")</span>
                            <span class="add-tier">T@(c.Mod.Tier)</span>
                            <span class="add-name">@c.Mod.Name</span>
                            <span class="add-sep">—</span>
                            <span class="add-stat">@c.Mod.Text</span>
                            @if (_manualMode)
                            {
                                <button class="btn btn-xs add-choose" @onclick="() => ChooseAddition(c.Mod.Id)">Choose</button>
                            }
                        </div>
                    }
                    @if (preview.Additions.Count > 20 && !_showAll)
                    {
                        <button class="btn btn-xs show-all-btn" @onclick="() => _showAll = true">Show all @(preview.Additions.Count) candidates...</button>
                    }
                </div>
            </div>
        }

        @* Special outcomes *@
        @if (preview.SpecialOutcomes.Count > 0)
        {
            <div class="distribution-section">
                <h4>Outcomes</h4>
                @foreach (var kv in preview.SpecialOutcomes)
                {
                    <div class="dist-row">
                        <div class="dist-bar-bg">
                            <div class="dist-bar special" style="width: @($"{kv.Value * 100:F1}")%"></div>
                        </div>
                        <span class="dist-pct">@($"{kv.Value:P1}")</span>
                        <span class="dist-label">@kv.Key</span>
                        @if (_manualMode)
                        {
                            <button class="btn btn-xs" @onclick="() => ChooseSpecial(kv.Key)">Choose</button>
                        }
                    </div>
                }
            </div>
        }

        @* Action buttons *@
        <div class="action-bar">
            <button class="btn btn-primary btn-execute" @onclick="DoExecute">
                Roll (Random)
            </button>
            <button class="btn @(_manualMode ? "btn-active" : "")" @onclick="() => _manualMode = !_manualMode">
                @(_manualMode ? "Hide Choices" : "Choose Outcome")
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CraftAction Action { get; set; } = null!;
    [Parameter] public EventCallback OnExecute { get; set; }
    [Parameter] public EventCallback<ManualChoice> OnChoose { get; set; }

    private bool _manualMode;
    private bool _showAll;

    private double MaxAddProb(StepPreview p) => p.Additions.Count > 0 ? p.Additions.Max(x => x.Probability) : 1;

    private async Task DoExecute() => await OnExecute.InvokeAsync();

    private async Task ChooseRemoval(int index)
    {
        await OnChoose.InvokeAsync(new ManualChoice { RemoveIndices = new() { index } });
    }

    private async Task ChooseAddition(string modId)
    {
        await OnChoose.InvokeAsync(new ManualChoice { AddModIds = new() { modId } });
    }

    private async Task ChooseSpecial(string outcome)
    {
        await OnChoose.InvokeAsync(new ManualChoice { SpecialOutcome = outcome });
    }
}
