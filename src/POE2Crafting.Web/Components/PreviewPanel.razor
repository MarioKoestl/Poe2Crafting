@* Simulator: chances of the chosen action on the current item (removals, additions, outcomes), Hinekora's foreseen result,
   and rolling or choosing the outcome manually (Chaos: removal first, then the addition). *@
@inject CraftingSession Session

<div class="preview-panel">
    @{
        var item = Session.CurrentItem;
        var preview = _preview!;
    }

    <h3 class="pane-title"><CraftText Text="@Action.DisplayName" /></h3>
    <ActionCost Items="Action.ConsumedItems" />

    @if (Action.Currency.Description.Count > 0)
    {
        <div class="currency-description">
            @foreach (var line in Action.Currency.Description)
            {
                <p>@line</p>
            }
        </div>
    }

    @if (!preview.Applicability.Ok || item == null)
    {
        <div class="error-banner">@preview.Applicability.Reason</div>
    }
    else
    {
        @if (_foreseen is { } foreseen)
        {
            <div class="foresee-section">
                <h4>Hinekora's Lock — foreseen result</h4>
                @if (foreseen.Destroyed)
                {
                    <div class="error-banner">This action would destroy the item.</div>
                }
                else
                {
                    <ItemDiffList Before="item" After="foreseen.Item" />
                }
                <p class="hint">This is exactly what applying does. Don't like it? Leave it — nothing is spent, and other currencies or omen combinations have their own foreseen results.</p>
                <button class="btn btn-primary" @onclick="() => Choose(null)">Apply foreseen result</button>
            </div>
        }

        @if (preview.Notes.Count > 0)
        {
            <div class="notes-section">
                @foreach (var note in preview.Notes)
                {
                    <div class="note">@note</div>
                }
            </div>
        }

        @if (Action.Currency.Op == CurrencyOps.Reveal)
        {
            <RevealOptions Action="Action" OnChoose="Choose" />
        }

        @if (preview.Quality is { } quality)
        {
            <QualityChoicePanel Item="item" Choice="quality" HighestReachableQuality="Session.Engine.Data.HighestReachableQuality"
                                OnApply="q => Choose(new ManualChoice { Quality = q })" />
        }

        @if (preview.Removals.Count > 0)
        {
            <div class="distribution-section">
                <h4>@(preview.RemovalLabel ?? $"Removal ({preview.RemoveCount}x)")</h4>
                <div class="distribution-list">
                    @foreach (var r in preview.Removals.OrderByDescending(x => x.Probability))
                    {
                        var pending = _pendingRemoval == r.Index;
                        <DistributionRow @key="r.Index" Probability="r.Probability" Label="@r.Mod.DisplayText()" Mod="r.Mod.Def" BarClass="removal" Highlighted="pending"
                                         ChooseLabel="@(preview.TwoStepChoice ? (pending ? "Chosen" : "Pick") : "Choose")"
                                         OnChoose="() => ChooseRemoval(r.Index, preview.TwoStepChoice)" />
                    }
                </div>
                @if (preview.TwoStepChoice)
                {
                    <div class="note">
                        @if (_pendingRemoval == null)
                        {
                            <text>Pick the removed modifier first to see what can be added afterwards, or choose an addition directly (a compatible removal is rolled).</text>
                        }
                        else
                        {
                            <text>Removal fixed. Now choose the added modifier below. </text>
                            <button class="btn btn-xs" @onclick="() => SetPendingRemoval(null)">Reset</button>
                        }
                    </div>
                }
            </div>
        }

        var firstAdditions = _chosenAdditions.Count > 0 ? _nextAdditions : preview.Additions;
        var candidateCount = firstAdditions.Count + preview.OtherAdditions.Count;
        @* picking a modifier by hand means finding it among hundreds of candidates *@
        @if (preview.AdditionsChoosable && candidateCount > SearchFrom)
        {
            <SearchBox @bind-Value="_additionFilter" Placeholder="@($"Search {candidateCount} possible modifiers (name, text, tag)...")" />
        }

        @foreach (var (listed, label, isFirst) in new[] { (firstAdditions, preview.AdditionLabel, true), (preview.OtherAdditions, preview.OtherAdditionLabel, false) })
        {
            // several additions (Omen of Greater Exaltation): after the first choice the list shows what the next addition can be
            var additions = listed;
            if (additions.Count == 0 && !(isFirst && _chosenAdditions.Count > 0)) continue;
            var matching = Matching(additions);
            var choosable = preview.AdditionsChoosable && preview.Additions.Count + preview.OtherAdditions.Count > 1;
            <div class="distribution-section" @key="@(isFirst ? "additions" : "other-additions")">
                <h4>
                    @(isFirst && preview.AddCount > 1 ? $"Addition {_chosenAdditions.Count + 1} of {preview.AddCount}" : label ?? $"Addition ({preview.AddCount}x)")
                    @if (matching.Count != additions.Count)
                    {
                        <text> — @matching.Count of @additions.Count</text>
                    }
                    else if (isFirst && _chosenAdditions.Count == 0 && preview.PrefixProbability + preview.SuffixProbability > 0)
                    {
                        <text> — P(@UiFormat.Probability(preview.PrefixProbability)) / S(@UiFormat.Probability(preview.SuffixProbability))</text>
                    }
                </h4>
                @if (isFirst && preview.AddCount > 1)
                {
                    <div class="note">
                        @if (_chosenAdditions.Count == 0)
                        {
                            <text>Choose the @preview.AddCount added modifiers one after another, or roll randomly.</text>
                        }
                        else
                        {
                            <text>Chosen: </text>
                            @foreach (var (id, _) in _chosenAdditions)
                            {
                                <strong>@(Session.Engine.Data.FindMod(id)?.Text ?? id)</strong><text>; </text>
                            }
                            <button class="btn btn-xs" @onclick="UndoAddition">Undo</button>
                            <button class="btn btn-xs" @onclick="ApplyChosenAdditions" title="Keep the chosen modifiers and roll the rest randomly">Roll the rest</button>
                        }
                    </div>
                    @if (additions.Count == 0)
                    {
                        <div class="error-banner">Nothing else can be added after these modifiers.</div>
                    }
                }
                @if (matching.Count == 0 && additions.Count > 0)
                {
                    <p class="hint">No possible modifier matches the search.</p>
                }
                <ModOptionList Candidates="matching" Item="item" AutoExpand="Searching"
                               OnChoose="@(choosable ? EventCallback.Factory.Create<ModDef>(this, PickAddition) : default)">
                    <AfterRow Context="mod">
                        @if (_pickedAddition == mod.Id)
                        {
                            <div class="value-pick">
                                <span class="hint">Rolled value:</span>
                                <ModValueInputs Mod="mod" Values="_pickedValues" />
                                <button class="btn btn-xs btn-primary" @onclick="ApplyPickedAddition">Apply</button>
                                <button class="btn btn-xs" @onclick="() => ChooseAddition(mod.Id, null)" title="Add this modifier with random values">Random value</button>
                                <button class="btn btn-xs" @onclick="() => _pickedAddition = null">Cancel</button>
                            </div>
                        }
                    </AfterRow>
                </ModOptionList>
            </div>
        }

        @if (preview.SpecialOutcomes.Count > 0)
        {
            <div class="distribution-section">
                <h4>Outcomes</h4>
                @foreach (var (outcome, chance) in preview.SpecialOutcomes)
                {
                    <DistributionRow @key="outcome" Probability="chance" Label="@outcome" BarClass="special" ChooseLabel="Choose"
                                     OnChoose="() => Choose(new ManualChoice { SpecialOutcome = outcome })" />
                }
            </div>
        }

        @if (preview.ValueRerolls.Count > 0)
        {
            <ValueRerollPanel Item="item" Rerolls="preview.ValueRerolls" OnApply="values => Choose(new ManualChoice { Rerolls = values })" />
        }

        <div class="sticky-actions">
            <button class="btn btn-primary btn-execute" @onclick="() => Choose(null)">@(item.Foreseeing ? "Apply (foreseen)" : "Roll (Random)")</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CraftAction Action { get; set; } = null!;
    /// <summary>Apply the action: null = roll randomly, otherwise the manual choice.</summary>
    [Parameter] public EventCallback<ManualChoice?> OnExecute { get; set; }

    /// <summary>From this many possible modifiers on, the addition lists get a search box.</summary>
    private const int SearchFrom = 10;

    /// <summary>Search over the modifiers that can be added (for picking one by hand instead of rolling).</summary>
    private string _additionFilter = "";
    /// <summary>While searching, the tier groups of the remaining candidates are open.</summary>
    private bool Searching => !string.IsNullOrWhiteSpace(_additionFilter);
    private int? _pendingRemoval;
    private CraftAction? _lastAction;
    private Item? _lastItem;
    private StepPreview? _preview;
    private CraftResult? _foreseen;
    /// <summary>The added modifier whose values are being entered, and those values.</summary>
    private string? _pickedAddition;
    private List<double> _pickedValues = new();
    /// <summary>Several additions: the modifiers chosen so far (with values; null = random) and the candidates of the next one.</summary>
    private readonly List<(string Id, List<double>? Values)> _chosenAdditions = new();
    private List<ModCandidate> _nextAdditions = new();

    protected override void OnParametersSet()
    {
        // a new action or a changed item invalidates half-made choices (mod indices refer to the old item)
        if (!ReferenceEquals(Action, _lastAction) || !ReferenceEquals(Session.CurrentItem, _lastItem))
        {
            _pendingRemoval = null;
            _pickedAddition = null;
            _chosenAdditions.Clear();
            _additionFilter = "";
            _lastAction = Action;
            _lastItem = Session.CurrentItem;
            _foreseen = Session.Foresee(Action);
        }
        _preview = Session.Preview(Action, _pendingRemoval);
    }

    /// <summary>The candidates that match the search (most likely first); the shown probabilities stay the real ones.</summary>
    private List<ModCandidate> Matching(IEnumerable<ModCandidate> candidates) =>
        candidates.Where(c => TextSearch.Matches(_additionFilter, new[] { c.Mod.DisplayName, c.Mod.Text, c.Mod.Family }.Concat(c.Mod.ModTags)))
            .OrderByDescending(c => c.Probability).ToList();

    /// <summary>
    /// Choose an added modifier: one without rolled values is applied at once; otherwise its value inputs open below the row (start: the middle of the ranges).
    /// </summary>
    private Task PickAddition(ModDef mod)
    {
        if (!ModValueInputs.HasRolledValues(mod)) return ChooseAddition(mod.Id, null);
        _pickedAddition = mod.Id;
        _pickedValues = ModValueInputs.MiddleValues(mod);
        return Task.CompletedTask;
    }

    private Task ApplyPickedAddition() => ChooseAddition(_pickedAddition!, _pickedValues.ToList());

    /// <summary>An added modifier is chosen: applied at once, or — while more additions are open (Omen of Greater Exaltation) — kept until the last one is chosen.</summary>
    private Task ChooseAddition(string modId, List<double>? values)
    {
        _pickedAddition = null;
        _chosenAdditions.Add((modId, values));
        if (_chosenAdditions.Count < _preview!.AddCount)
        {
            _nextAdditions = Session.NextAdditions(Action, _chosenAdditions.Select(c => c.Id).ToList());
            return Task.CompletedTask;
        }
        return ApplyChosenAdditions();
    }

    /// <summary>Apply the chosen additions; additions not chosen yet roll randomly.</summary>
    private Task ApplyChosenAdditions()
    {
        var choice = new ManualChoice { AddModIds = _chosenAdditions.Select(c => c.Id).ToList(), Values = _chosenAdditions.Select(c => c.Values).ToList() };
        _chosenAdditions.Clear();
        return Choose(choice);
    }

    private void UndoAddition()
    {
        _pickedAddition = null;
        _chosenAdditions.RemoveAt(_chosenAdditions.Count - 1);
        if (_chosenAdditions.Count > 0) _nextAdditions = Session.NextAdditions(Action, _chosenAdditions.Select(c => c.Id).ToList());
    }

    private void SetPendingRemoval(int? index)
    {
        _pendingRemoval = index;
        _preview = Session.Preview(Action, _pendingRemoval);
    }

    private Task ChooseRemoval(int index, bool twoStep)
    {
        if (!twoStep) return Choose(new ManualChoice { RemoveIndices = { index } });
        SetPendingRemoval(_pendingRemoval == index ? null : index);
        return Task.CompletedTask;
    }

    /// <summary>Execute with the choice; a pending (two-step) removal is added to it.</summary>
    private Task Choose(ManualChoice? choice)
    {
        if (choice != null && _pendingRemoval is { } r && choice.RemoveIndices.Count == 0) choice.RemoveIndices.Add(r);
        _pendingRemoval = null;
        return OnExecute.InvokeAsync(choice);
    }
}
