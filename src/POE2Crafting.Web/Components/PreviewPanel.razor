@* Simulator: chances of the chosen action on the current item (removals, additions, outcomes), Hinekora's foreseen result,
   and rolling or choosing the outcome manually (Chaos: removal first, then the addition). *@
@inject CraftingSession Session

<div class="preview-panel">
    @{
        var item = Session.CurrentItem;
        var preview = _preview!;
    }

    <h3 class="pane-title"><CraftText Text="@Action.DisplayName" /></h3>

    @if (Action.Currency.Description.Count > 0)
    {
        <div class="currency-description">
            @foreach (var line in Action.Currency.Description)
            {
                <p>@line</p>
            }
        </div>
    }

    @if (!preview.Applicability.Ok || item == null)
    {
        <div class="error-banner">@preview.Applicability.Reason</div>
    }
    else
    {
        @if (_foreseen is { } foreseen)
        {
            <div class="foresee-section">
                <h4>Hinekora's Lock — foreseen result</h4>
                @if (foreseen.Destroyed)
                {
                    <div class="error-banner">This action would destroy the item.</div>
                }
                else
                {
                    <ItemDiffList Before="item" After="foreseen.Item" />
                }
                <p class="hint">This is exactly what applying does. Don't like it? Leave it — nothing is spent, and other currencies or omen combinations have their own foreseen results.</p>
                <button class="btn btn-primary" @onclick="() => Choose(null)">Apply foreseen result</button>
            </div>
        }

        @if (preview.Notes.Count > 0 || preview.WeightsNote != null)
        {
            <div class="notes-section">
                @foreach (var note in preview.Notes)
                {
                    <div class="note">@note</div>
                }
                @if (preview.WeightsNote != null)
                {
                    <div class="note note-muted">@preview.WeightsNote</div>
                }
            </div>
        }

        @if (preview.Removals.Count > 0)
        {
            <div class="distribution-section">
                <h4>@(preview.RemovalLabel ?? $"Removal ({preview.RemoveCount}x)")</h4>
                <div class="distribution-list">
                    @foreach (var r in preview.Removals.OrderByDescending(x => x.Probability))
                    {
                        var pending = _pendingRemoval == r.Index;
                        <DistributionRow @key="r.Index" Probability="r.Probability" Label="@r.Mod.DisplayText()" BarClass="removal" Highlighted="pending"
                                         ChooseLabel="@(!_manualMode ? null : preview.TwoStepChoice ? (pending ? "Chosen" : "Pick") : "Choose")"
                                         OnChoose="() => ChooseRemoval(r.Index, preview.TwoStepChoice)" />
                    }
                </div>
                @if (_manualMode && preview.TwoStepChoice)
                {
                    <div class="note">
                        @if (_pendingRemoval == null)
                        {
                            <text>Pick the removed modifier first to see what can be added afterwards, or choose an addition directly (a compatible removal is rolled).</text>
                        }
                        else
                        {
                            <text>Removal fixed. Now choose the added modifier below. </text>
                            <button class="btn btn-xs" @onclick="() => SetPendingRemoval(null)">Reset</button>
                        }
                    </div>
                }
            </div>
        }

        @if (preview.Additions.Count > 0)
        {
            var choosable = _manualMode && preview.AdditionsChoosable && preview.Additions.Count > 1;
            <div class="distribution-section">
                <h4>
                    @(preview.AdditionLabel ?? $"Addition ({preview.AddCount}x)")
                    @if (preview.PrefixProbability + preview.SuffixProbability > 0)
                    {
                        <text> — P(@UiFormat.Probability(preview.PrefixProbability)) / S(@UiFormat.Probability(preview.SuffixProbability))</text>
                    }
                </h4>
                <div class="addition-list">
                    @foreach (var c in preview.Additions.OrderByDescending(c => c.Probability).Take(_showAll ? int.MaxValue : CollapsedAdditions))
                    {
                        var modId = c.Mod.Id;
                        <ModOptionRow @key="modId" Mod="c.Mod" Item="item" Probability="c.Probability"
                                      OnChoose="@(choosable ? EventCallback.Factory.Create(this, () => Choose(new ManualChoice { AddModIds = { modId } })) : default)" />
                    }
                    @if (preview.Additions.Count > CollapsedAdditions && !_showAll)
                    {
                        <button class="btn btn-xs show-all-btn" @onclick="() => _showAll = true">Show all @(preview.Additions.Count) candidates...</button>
                    }
                </div>
            </div>
        }

        @if (preview.SpecialOutcomes.Count > 0)
        {
            <div class="distribution-section">
                <h4>Outcomes</h4>
                @foreach (var (outcome, chance) in preview.SpecialOutcomes)
                {
                    <DistributionRow @key="outcome" Probability="chance" Label="@outcome" BarClass="special" ChooseLabel="@(_manualMode ? "Choose" : null)"
                                     OnChoose="() => Choose(new ManualChoice { SpecialOutcome = outcome })" />
                }
            </div>
        }

        <div class="sticky-actions">
            <button class="btn btn-primary btn-execute" @onclick="() => Choose(null)">@(item.Foreseeing ? "Apply (foreseen)" : "Roll (Random)")</button>
            <button class="btn @(_manualMode ? "btn-active" : "")" @onclick="ToggleManual">
                @(_manualMode ? "Hide Choices" : "Choose Outcome")
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CraftAction Action { get; set; } = null!;
    /// <summary>Apply the action: null = roll randomly, otherwise the manual choice.</summary>
    [Parameter] public EventCallback<ManualChoice?> OnExecute { get; set; }

    /// <summary>Additions listed before "Show all".</summary>
    private const int CollapsedAdditions = 20;

    private bool _manualMode;
    private bool _showAll;
    private int? _pendingRemoval;
    private CraftAction? _lastAction;
    private Item? _lastItem;
    private StepPreview? _preview;
    private CraftResult? _foreseen;

    protected override void OnParametersSet()
    {
        // a new action or a changed item invalidates half-made choices (mod indices refer to the old item)
        if (!ReferenceEquals(Action, _lastAction) || !ReferenceEquals(Session.CurrentItem, _lastItem))
        {
            _pendingRemoval = null;
            _showAll = false;
            _lastAction = Action;
            _lastItem = Session.CurrentItem;
            _foreseen = Session.Foresee(Action);
        }
        _preview = Session.Preview(Action, _pendingRemoval);
    }

    private void SetPendingRemoval(int? index)
    {
        _pendingRemoval = index;
        _preview = Session.Preview(Action, _pendingRemoval);
    }

    private void ToggleManual()
    {
        _manualMode = !_manualMode;
        SetPendingRemoval(null);
    }

    private Task ChooseRemoval(int index, bool twoStep)
    {
        if (!twoStep) return Choose(new ManualChoice { RemoveIndices = { index } });
        SetPendingRemoval(_pendingRemoval == index ? null : index);
        return Task.CompletedTask;
    }

    /// <summary>Execute with the choice; a pending (two-step) removal is added to it.</summary>
    private Task Choose(ManualChoice? choice)
    {
        if (choice != null && _pendingRemoval is { } r && choice.RemoveIndices.Count == 0) choice.RemoveIndices.Add(r);
        _pendingRemoval = null;
        return OnExecute.InvokeAsync(choice);
    }
}
