@* Planner results: strategy cards, then the chosen strategy as a step-by-step guide (StrategyGuide) or flowchart. State lives in PlannerState. *@
@inherits PlannerStateComponentBase

<div class="planner-panel">
    <h3 class="pane-title">Crafting Paths</h3>
    @if (Planner.Result is not { } result)
    {
        <EmptyState Icon="⟡">Choose source and target items of your project, edit the target and click <strong>Find Paths</strong>.</EmptyState>
    }
    else if (result.Plan.Strategies.Count == 0)
    {
        <EmptyState Icon="⟡">No viable strategies found for this target. Try adjusting the target mods or item level.</EmptyState>
        <PlannerProblems Problems="result.Plan.Problems" />
    }
    else
    {
        <PlannerProblems Problems="result.Plan.Problems" />
        <div class="planner-header">
            <h4>@UiFormat.Plural(result.Plan.Strategies.Count, "Strategy", "Strategies") Found</h4>
            <div class="source-item-info">Starting from: @result.Start</div>
        </div>

        <div class="strategy-list">
            @foreach (var strategy in result.Plan.Strategies)
            {
                <StrategyCard @key="strategy.Id" Strategy="strategy" Selected="ReferenceEquals(strategy, Planner.SelectedStrategy)" OnSelect="() => Select(strategy)">
                    <CraftText Text="@strategy.Description" />
                </StrategyCard>
            }
        </div>

        @if (Planner.SelectedStrategy is { } selected)
        {
            <div class="strategy-detail">
                <div class="detail-tabs">
                    <button class="btn btn-sm @(_showDiagram ? "" : "btn-active")" @onclick="() => _showDiagram = false">Guide</button>
                    <button class="btn btn-sm @(_showDiagram ? "btn-active" : "")" @onclick="() => _showDiagram = true">Flowchart</button>
                    <GuideExportButton Export="@(new GuideExport($"{selected.Name}: {result.Start.BaseName}", selected.Description, result.Start, selected) { Problems = result.Plan.Problems })" />
                </div>

                @if (_showDiagram)
                {
                    <MermaidDiagram Definition="@CraftingPathFinder.ToMermaid(selected)" DiagramId="@($"strat-{selected.Id}")" />
                }
                else
                {
                    <StrategyGuide Strategy="selected" Start="result.Start" />
                }
            </div>
        }
    }
</div>

@code {
    private bool _showDiagram;

    private void Select(CraftingStrategy strategy)
    {
        _showDiagram = false;
        Planner.SelectStrategy(strategy);
    }
}
