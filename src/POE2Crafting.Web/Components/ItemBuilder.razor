@* Planner: source and target items chosen from the open project (the target is loaded into a draft and edited), then "Find Paths".
   State lives in PlannerState. *@
@inherits PlannerStateComponentBase
@inject CraftingSession Session

<div class="item-builder">
    <h3 class="pane-title">Source &amp; Target</h3>

    @if (Session.CurrentItem is not { } currentItem)
    {
        <p class="hint">Import or compose an item on the left first; source and target are items of your project.</p>
    }
    else
    {
        var items = Session.Project?.Items.Where(i => i.Current?.Base != null).ToList() ?? new();
        <div class="builder-form planner-items">
            <div class="form-row">
                <label for="planner-source">Source item:</label>
                <select id="planner-source" value="@(Session.FindProjectItem(Planner.SourceItemId) != null ? Planner.SourceItemId : "")"
                        @onchange="e => Planner.SourceItemId = NullIfEmpty(e.Value)">
                    <option value="">Current item: @currentItem.Title</option>
                    @foreach (var entry in items)
                    {
                        <option value="@entry.Id">@Label(entry, items)</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label for="planner-target">Target item:</label>
                <select id="planner-target" value="@(Planner.TargetItemId ?? "")" @onchange="e => LoadTarget(NullIfEmpty(e.Value))"
                        title="Take base, rarity, item level, modifiers, quality, augments and instill of the item as the target, then edit it">
                    <option value="">-- choose the target --</option>
                    @foreach (var entry in items)
                    {
                        <option value="@entry.Id">@Label(entry, items)</option>
                    }
                </select>
                @if (Session.FindProjectItem(Planner.TargetItemId) != null)
                {
                    <button class="btn btn-sm" title="Load the item again (discards the edits of the target)" @onclick="() => LoadTarget(Planner.TargetItemId)">Reload</button>
                }
            </div>
        </div>
    }

    @if (Draft.Base != null)
    {
        <div class="hint">Target base: <strong>@Draft.Base.Name</strong> (ilvl @Draft.ItemLevel)</div>

        @if (Draft.Preview != null)
        {
            <div class="builder-preview">
                <ItemDisplay Item="Draft.Preview" />
            </div>
        }

        <BaseItemForm Draft="Draft" RarityLabel="Target Rarity" ShowBase="false" OnChanged="StateHasChanged" />
        <ModBrowser Draft="Draft" Title="Target Modifiers" ValueLabel="min" AllowQualityValues="true" OnChanged="StateHasChanged" />

        <label class="checkbox-row" title="Count a roll of a better tier than the selected one as a hit">
            <input type="checkbox" @bind="Planner.AllowBetterTiers" /> Better tiers also count as a hit
        </label>

        <FinishingTargetForm Target="Planner.Finishing" Base="Draft.Base" OnChanged="StateHasChanged" />

        @if (_error != null)
        {
            <div class="error-banner" role="alert">@_error</div>
        }
        <div class="sticky-actions">
            @{
                var source = SourceItem;
                var sameBase = source != null && ReferenceEquals(source.Base, Draft.Base);
            }
            <button class="btn btn-primary btn-execute" @onclick="FindPaths" disabled="@(!sameBase || Planner.Planning)"
                    title="@(sameBase ? "Calculate the steps from the source item to this target" : "Source and target have different bases: choose items of the same base")">
                @(Planner.Planning ? "Planning…" : "Find Paths")
            </button>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private string? _error;

    private ItemDraft Draft => Planner.Draft;

    /// <summary>The chosen project item, or the current item (also when the chosen one is gone, e.g. after switching projects).</summary>
    private Item? SourceItem => Session.FindProjectItem(Planner.SourceItemId) ?? Session.CurrentItem;

    private static string? NullIfEmpty(object? value) => value?.ToString() is { Length: > 0 } id ? id : null;

    /// <summary>"Title (Rare, 1P/2S, 3 steps)", numbered when several project items have the same title.</summary>
    private static string Label(ProjectItem entry, List<ProjectItem> items)
    {
        var item = entry.Current!;
        var sameTitle = items.Where(i => i.Current!.Title == item.Title).ToList();
        var number = sameTitle.Count > 1 ? $" #{sameTitle.IndexOf(entry) + 1}" : "";
        return $"{item.Title}{number} ({item.Rarity}, {item.PrefixCount}P/{item.SuffixCount}S, {UiFormat.Plural(entry.History.Count - 1, "step")})";
    }

    private void LoadTarget(string? itemId)
    {
        Planner.TargetItemId = itemId;
        if (Session.FindProjectItem(itemId) is not { } item) return;
        Draft.LoadFrom(item, copyValues: false);
        Planner.Finishing.LoadFrom(item, Session.Engine.Data);
    }

    private async Task FindPaths()
    {
        if (SourceItem is not { } start) return;
        var spec = new TargetItemSpec
        {
            TargetRarity = Draft.Rarity,
            TargetMods = Draft.Selection.ToTargetMods(Session.Engine.Pool, start, Planner.AllowBetterTiers),
        };
        Planner.Finishing.ApplyTo(spec);
        var snapshot = start.Clone();
        _error = null;
        Planner.SetPlanning(true);
        try
        {
            // the search evaluates many item states (a few seconds for multi-step techniques): keep the page responsive
            var plan = await Task.Run(() => new CraftingPathFinder(Session.Engine).FindPathsFromItem(snapshot, spec), _disposed.Token);
            Planner.ShowResult(new PlannerResult(plan, snapshot));
        }
        catch (OperationCanceledException)
        {
            // the page was closed while planning
        }
        catch (Exception ex)
        {
            _error = $"Planning failed: {ex.Message}";
        }
        finally
        {
            Planner.SetPlanning(false);
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
