@inject CraftingSession Session
@inject GameData Data

<div class="item-builder">
    <h3 class="pane-title">Target Item</h3>

    @if (Session.CurrentItem is { Base: not null } currentItem)
    {
        <div class="builder-hint">
            <button class="btn btn-sm" @onclick="() => _draft.LoadFrom(currentItem, copyValues: false)"
                    title="Take base, rarity, item level and modifiers of the current item as the target, then edit it">
                Load current item as target
            </button>
        </div>
    }
    else
    {
        <p class="rarity-note">Import or compose an item on the left first; the target is built from that item.</p>
    }

    @if (_draft.Base != null)
    {
        <div class="builder-hint">Target base: <strong>@_draft.Base.Name</strong> (ilvl @_draft.ItemLevel)</div>

        @if (_draft.Preview != null)
        {
            <div class="builder-preview">
                <ItemDisplay Item="_draft.Preview" />
            </div>
        }

        <BaseItemForm Draft="_draft" RarityLabel="Target Rarity" ShowBase="false" OnChanged="StateHasChanged" />
        <ModBrowser Draft="_draft" Title="Target Modifiers" ValueLabel="min" OnChanged="StateHasChanged" />

        <label class="checkbox-row" title="Count a roll of a better tier than the selected one as a hit">
            <input type="checkbox" @bind="_allowBetterTiers" /> Better tiers also count as a hit
        </label>

        <div class="builder-actions sticky-actions">
            @{
                var sameBase = Session.CurrentItem != null && ReferenceEquals(Session.CurrentItem.Base, _draft.Base);
            }
            <button class="btn btn-primary btn-execute" @onclick="FindPaths" disabled="@(!sameBase)"
                    title="@(sameBase ? "Calculate the steps from the current item to this target" : "The item on the left has a different base: load it as target again")">
                Path from Current Item
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<PlannerResult> OnPathsFound { get; set; }

    private ItemDraft _draft = null!;
    private bool _allowBetterTiers = true;

    protected override void OnInitialized() => _draft = new ItemDraft(Data);

    private async Task FindPaths()
    {
        if (Session.CurrentItem is not { } start) return;
        var spec = new TargetItemSpec
        {
            BaseName = start.BaseName,
            ItemClass = start.ItemClass,
            ItemLevel = start.ItemLevel,
            TargetRarity = _draft.Rarity,
            TargetMods = _draft.Selection.ToTargetMods(Session.Engine.Pool, start, _allowBetterTiers),
        };
        var plan = new CraftingPathFinder(Data, Session.Engine.Pool).FindPathsFromItem(start, spec);
        await OnPathsFound.InvokeAsync(new PlannerResult { Plan = plan, SourceItemDescription = start.ToString() });
    }

    public sealed class PlannerResult
    {
        public PlanResult Plan { get; init; } = new();
        public string SourceItemDescription { get; init; } = "";
    }
}
