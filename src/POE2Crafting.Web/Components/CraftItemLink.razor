@* Name of a currency, essence, alloy, catalyst or omen, highlighted; hovering it shows a box with icon, kind and description.
   The box is plain CSS hover (placed by site.js positionPopover), so hovering never talks to the server. Clicks pass through
   (e.g. a currency tile is still selected). Unknown names render as plain text. *@
@inject GameData Data

@if (Data.FindCraftItem(Name) is not { } info)
{
    @Name
}
else
{
    <span class="craft-link-wrap" onmouseenter="positionPopover(this)">
        <span class="craft-link">
            @if (ShowIcon)
            {
                <CraftIcon Url="@info.IconUrl" Class="craft-link-icon" />
            }
            @info.Name
        </span>
        <span class="craft-popover" role="tooltip">
            <span class="craft-popover-head">
                <CraftIcon Url="@info.IconUrl" Class="craft-popover-icon" />
                <span>
                    <span class="craft-popover-name">@info.Name</span>
                    <span class="craft-popover-kind">@info.Kind</span>
                </span>
            </span>
            @foreach (var line in info.Description)
            {
                <span class="craft-popover-line">@line</span>
            }
            @foreach (var fact in info.Facts)
            {
                <span class="craft-popover-fact">@fact</span>
            }
        </span>
    </span>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    /// <summary>False where the icon is already shown next to the name (currency tiles).</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;
}
