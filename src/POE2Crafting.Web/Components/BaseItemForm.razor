@* Item class / base / rarity / item level selectors of an ItemDraft, shared by the Item Composer and the Planner. *@
@inherits ChangingComponentBase
@inject GameData Data

<div class="builder-form">
    @if (ShowBase)
    {
        <div class="form-row">
            <label for="item-class">Item Class:</label>
            <select id="item-class" value="@Draft.ItemClass" @onchange="OnClassChanged">
                <option value="">-- Select --</option>
                @foreach (var cls in Data.ItemClasses.OrderBy(c => c.Name))
                {
                    <option value="@cls.Name">@cls.Name (@UiFormat.Plural(cls.BaseCount, "base"))</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(Draft.ItemClass))
        {
            <div class="form-row">
                <label for="base-item">Base Item:</label>
                <select id="base-item" value="@Draft.BaseName" @onchange="e => Change(() => Draft.BaseName = Text(e))">
                    <option value="">-- Select --</option>
                    @foreach (var b in Data.BasesOfClass(Draft.ItemClass).Where(b => !b.Hidden).OrderBy(b => b.Name))
                    {
                        <option value="@b.Name">@b.Name@(string.IsNullOrEmpty(b.Implicit) ? "" : $" — {b.Implicit}")</option>
                    }
                </select>
            </div>
        }
    }

    <div class="form-row">
        <label for="rarity">@RarityLabel:</label>
        <select id="rarity" value="@Draft.Rarity" @onchange="e => Change(() => { if (Enum.TryParse<Rarity>(Text(e), out var r)) Draft.Rarity = r; })">
            @foreach (var rarity in new[] { Rarity.Normal, Rarity.Magic, Rarity.Rare })
            {
                <option value="@rarity">@rarity</option>
            }
        </select>
    </div>

    @if (ShowBase)
    {
        <div class="form-row">
            <label for="item-level">Item Level:</label>
            <input id="item-level" type="number" min="1" max="100" value="@Draft.ItemLevel"
                   @onchange="e => Change(() => { if (int.TryParse(Text(e), out var v)) Draft.ItemLevel = v; })" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ItemDraft Draft { get; set; } = null!;
    [Parameter] public string RarityLabel { get; set; } = "Rarity";
    /// <summary>False when base and item level are fixed (Planner: the target always has the current item's base).</summary>
    [Parameter] public bool ShowBase { get; set; } = true;

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private Task OnClassChanged(ChangeEventArgs e) => Change(() =>
    {
        Draft.ItemClass = Text(e);
        Draft.BaseName = "";
    });
}
