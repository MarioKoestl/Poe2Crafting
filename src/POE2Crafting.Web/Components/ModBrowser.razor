@* Mod picker of an ItemDraft, shared by the Item Composer and the Crafting Planner: chosen mods, Prefix/Suffix tabs, category sections, tier groups. *@
@inherits ChangingComponentBase
@inject ModPool Pool
@inject GameData Data

@if (Draft.Base == null || _virtualItem == null)
{
    return;
}

@if (Draft.Rarity == Rarity.Normal)
{
    <div class="target-mods-section">
        <p class="hint">Normal items have no explicit modifiers. Select <strong>Magic</strong> or <strong>Rare</strong> to add mods.</p>
    </div>
    return;
}

<div class="target-mods-section">
    <h4>@Title <span class="mod-count">(@Selection.Count(AffixType.Prefix)P / @Selection.Count(AffixType.Suffix)S)</span></h4>

    @if (Selection.Mods.Count > 0)
    {
        <div class="target-mod-list">
            @for (int i = 0; i < Selection.Mods.Count; i++)
            {
                var idx = i;
                var sm = Selection.Mods[i];
                var cat = CategoryOf(sm.Category);
                <div class="target-mod-row @AffixUi.Css(sm.Mod.AffixType, "-row") @cat.RowClass" @key="sm.Mod.Id">
                    <span class="tm-type @AffixUi.TypeCss(sm.Mod.AffixType)">@AffixUi.Letter(sm.Mod.AffixType)</span>
                    <span class="tm-tier">T@(Pool.DisplayTier(sm.Mod, _virtualItem))</span>
                    <span class="tm-name">@sm.Mod.DisplayName</span>
                    <span class="tm-text">@sm.Mod.Text</span>
                    @for (int r = 0; r < sm.Values.Count; r++)
                    {
                        var ri = r;
                        var (lo, hi) = sm.ValueBounds(ri, AllowQualityValues, Data);
                        if (lo == hi) continue;
                        <input type="number" class="tm-value" step="any" min="@lo" max="@hi" aria-label="@ValueLabel value"
                               placeholder="@ValueLabel" title="@ValueTitle(sm, ri, hi)"
                               value="@sm.Values[ri]" @onchange="e => SetValue(sm, ri, e.Value)" />
                    }
                    @if (cat.ShortName != null)
                    {
                        <span class="tm-cat-badge @cat.BadgeClass">@cat.ShortName</span>
                    }
                    <button class="icon-remove" title="Remove modifier" aria-label="Remove modifier" @onclick="() => ChangeSelection(() => Selection.RemoveAt(idx))">✕</button>
                </div>
            }
        </div>
    }

    <div class="add-mod-section">
        <div class="add-mod-tabs">
            @foreach (var type in AffixTypeExtensions.Both)
            {
                <button class="btn btn-sm @(_affixType == type ? "btn-active" : "")" @onclick="() => _affixType = type">
                    + @type (@Selection.Count(type)/@Selection.Max(Draft.Rarity, type))
                </button>
            }
        </div>

        <SearchBox @bind-Value="_filter" Placeholder="Search prefixes and suffixes..." />
        @if (Searching)
        {
            <p class="hint">Searching prefixes and suffixes; clear the search to browse by tab.</p>
        }

        <div class="mod-browser">
            @foreach (var affixType in VisibleTypes)
            {
                @foreach (var cat in Categories)
                {
                    var category = cat.Key;
                    var sectionKey = $"{category}|{affixType}";
                    var groups = FilteredGroups(category, affixType);
                    if (groups.Count == 0) continue;
                    var autoExpand = Searching && groups.Count <= AutoExpandLimit;
                    var collapsed = _collapsed.Contains(sectionKey);
                    <div class="mod-category-section" @key="sectionKey">
                        <button type="button" class="mod-category-header @cat.HeaderClass" aria-expanded="@(collapsed ? "false" : "true")" @onclick="() => _collapsed.Toggle(sectionKey)">
                            <span class="cat-expand">@(collapsed ? "▸" : "▾")</span>
                            <span class="cat-label @cat.LabelClass">@cat.Label @affixType</span>
                            <span class="cat-count">@groups.Count</span>
                        </button>
                        @if (!collapsed)
                        {
                            <div>
                                @foreach (var group in groups)
                                {
                                    var isAdded = Selection.HasFamily(group.Tiers[0].Mod.Family);
                                    var expanded = _expanded.Contains(group.Key) != autoExpand;
                                    <div class="mod-family @(isAdded ? "family-added" : "")" @key="group.Key">
                                        <button type="button" class="family-header" aria-expanded="@(expanded ? "true" : "false")" @onclick="() => _expanded.Toggle(group.Key)">
                                            <span class="family-expand">@(expanded ? "▾" : "▸")</span>
                                            <span class="family-name">@group.Label</span>
                                            @foreach (var tag in group.Tags)
                                            {
                                                <span class="mod-tag tag-@TagClass(tag)">@tag</span>
                                            }
                                            @if (isAdded) { <span class="family-badge">added</span> }
                                        </button>
                                        @if (expanded)
                                        {
                                            <div class="family-tiers">
                                                @foreach (var (mod, tier) in group.Tiers)
                                                {
                                                    var selected = Selection.Contains(mod);
                                                    var enabled = selected || Selection.CanAdd(mod, Draft.Rarity, Draft.ItemLevel);
                                                    <button type="button" class="tier-btn @(selected ? "selected" : "")" disabled="@(!enabled)" @key="mod.Id"
                                                            @onclick="() => ChangeSelection(() => Selection.Toggle(mod, category, Draft.Rarity, Draft.ItemLevel))"
                                                            title="@(mod.Level > Draft.ItemLevel ? $"Requires item level {mod.Level}" : "")">
                                                        <span class="tier-label">T@(tier)</span>
                                                        <span class="tier-name">@mod.DisplayName</span>
                                                        <span class="tier-text">@mod.Text</span>
                                                        <span class="tier-weight" title="Estimated weight (poe2db)">@Pool.WeightForItem(mod, _virtualItem)</span>
                                                        <span class="tier-level">ilvl @mod.Level</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ItemDraft Draft { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Modifiers";
    /// <summary>Placeholder of the value inputs: the actual value in the composer, the minimum value in the planner.</summary>
    [Parameter] public string ValueLabel { get; set; } = "value";
    /// <summary>Planner targets: values of mods that catalyst quality enhances may go above the roll range (e.g. +4 from a fixed +3).</summary>
    [Parameter] public bool AllowQualityValues { get; set; }

    /// <summary>Sections whose families are expanded automatically while searching (few results).</summary>
    private const int AutoExpandLimit = 6;
    private const int ShownTags = 3;

    private ModSelection Selection => Draft.Selection;

    private sealed record CategoryInfo(string Key, string Label, string HeaderClass, string LabelClass, string? ShortName, string BadgeClass, string RowClass);
    /// <summary>Categories offered in the browser.</summary>
    private static readonly CategoryInfo[] Categories =
    {
        new(ModCategories.Normal, "Base", "", "base-label", null, "", ""),
        new(ModCategories.Otherworldly, "Otherworldly", "otherworldly-header", "otherworldly-label", "OW", "cat-badge-otherworldly", "otherworldly-row"),
        new(ModCategories.Desecrated, "Desecrated", "desecrated-header", "desecrated-label", "Des", "cat-badge-desecrated", "desecrated-row"),
    };
    /// <summary>Categories that only appear when taken over from an existing item.</summary>
    private static readonly CategoryInfo[] LoadedOnly =
    {
        new(ModCategories.Essence, "Essence", "", "", "Ess", "cat-badge-crafted", ""),
        new(ModCategories.PerfectEssence, "Perfect Essence", "", "", "Crafted", "cat-badge-crafted", ""),
    };
    private static readonly Dictionary<string, CategoryInfo> CategoryByKey = Categories.Concat(LoadedOnly).ToDictionary(c => c.Key);
    private static CategoryInfo CategoryOf(string key) => CategoryByKey.GetValueOrDefault(key, Categories[0]);

    /// <summary>One family/stat of a category with its tiers (best first), precomputed per base.</summary>
    private sealed record TierGroup(string Key, string Label, AffixType Type, List<string> Tags, List<(ModDef Mod, int Tier)> Tiers, string SearchText);

    private Item? _virtualItem;
    /// <summary>category → tier groups sorted by label (all tiers, not filtered by item level so the full picture is visible).</summary>
    private Dictionary<string, List<TierGroup>> _groups = new();
    private AffixType _affixType = AffixType.Prefix;
    private string _filter = "";
    private readonly HashSet<string> _expanded = new();
    private readonly HashSet<string> _collapsed = new();

    protected override void OnParametersSet()
    {
        if (Draft.Base == null) { _virtualItem = null; return; }
        if (ReferenceEquals(Draft.Base, _virtualItem?.Base)) return;
        _expanded.Clear();
        var item = _virtualItem = Item.FromBase(Draft.Base);
        _groups = Categories.ToDictionary(c => c.Key, c => Pool.AllForBaseByCategory(item, c.Key)
            .GroupBy(ModTiers.TierGroupKey)
            .Select(g => new TierGroup(g.Key, GroupLabel(g), g.First().AffixType,
                g.SelectMany(m => m.ModTags).Distinct().Take(ShownTags).ToList(),
                g.Select(m => (Mod: m, Tier: Pool.DisplayTier(m, item))).OrderBy(t => t.Tier).ToList(),
                string.Join("\n", g.SelectMany(m => new[] { m.Family, m.Text, m.Name }.Concat(m.ModTags)))))
            .OrderBy(g => g.Label)
            .ToList());
    }

    private bool Searching => !string.IsNullOrWhiteSpace(_filter);

    /// <summary>Browsing shows the selected tab's affix type; a search covers prefixes and suffixes.</summary>
    private IEnumerable<AffixType> VisibleTypes => Searching ? AffixTypeExtensions.Both : new[] { _affixType };

    private List<TierGroup> FilteredGroups(string category, AffixType type) =>
        _groups.TryGetValue(category, out var groups)
            ? groups.Where(g => g.Type == type && TextSearch.Matches(_filter, g.SearchText)).ToList()
            : new();

    private Task SetValue(SelectedMod mod, int rangeIndex, object? input)
    {
        var (lo, hi) = mod.ValueBounds(rangeIndex, AllowQualityValues, Data);
        mod.Values[rangeIndex] = double.TryParse(input?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)
            ? Math.Clamp(v, lo, hi)
            : null;
        return ChangeSelection(() => { });
    }

    private string ValueTitle(SelectedMod mod, int index, double hi)
    {
        var (rollLo, rollHi) = ModText.Bounds(mod.Mod.StatRanges[index]);
        return hi > rollHi
            ? $"{ValueLabel} (roll {rollLo}–{rollHi}; up to {hi} with {string.Join("/", Data.CatalystsEnhancing(mod.Mod).Select(c => c.QualityType).Distinct())} catalyst quality)"
            : $"{ValueLabel} ({rollLo}–{rollHi})";
    }

    /// <summary>Change the selection, re-apply the draft's rules, then notify the parent.</summary>
    private Task ChangeSelection(Action change) => Change(() =>
    {
        change();
        Draft.Refresh();
    });

    /// <summary>Group label = the lowest tier's text with numbers stripped, e.g. "#% increased Spell Damage".</summary>
    private static string GroupLabel(IEnumerable<ModDef> mods)
    {
        var first = mods.MinBy(m => m.Level)!;
        return string.IsNullOrWhiteSpace(first.Text) ? first.Name : ModText.StripNumbers(first.Text);
    }

    /// <summary>Tag colour classes in site.css (.mod-tag.tag-*): the first known tag word the tag contains.</summary>
    private static readonly string[] ColouredTags =
        { "life", "fire", "mana", "cold", "speed", "lightning", "chaos", "physical", "critical", "attribute", "resistance", "defences", "armour", "evasion", "energy_shield", "attack", "caster", "minion" };

    private static string TagClass(string tag) => ColouredTags.FirstOrDefault(tag.Contains) ?? "other";
}
