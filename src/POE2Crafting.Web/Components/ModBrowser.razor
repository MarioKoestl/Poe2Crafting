@* Mod picker of an ItemDraft, shared by the Item Composer and the Crafting Planner: chosen mods, Prefix/Suffix tabs, category sections, tier groups. *@
@inject ModPool Pool

@if (Draft.Base == null || _virtualItem == null)
{
    return;
}

@if (Draft.Rarity == Rarity.Normal)
{
    <div class="target-mods-section">
        <p class="rarity-note">Normal items have no explicit modifiers. Select <strong>Magic</strong> or <strong>Rare</strong> to add mods.</p>
    </div>
    return;
}

<div class="target-mods-section">
    <h4>@Title <span class="mod-count">(@Selection.Count(AffixType.Prefix)P / @Selection.Count(AffixType.Suffix)S)</span></h4>

    @if (Selection.Mods.Count > 0)
    {
        <div class="target-mod-list">
            @for (int i = 0; i < Selection.Mods.Count; i++)
            {
                var idx = i;
                var sm = Selection.Mods[i];
                var cat = CategoryOf(sm.Category);
                <div class="target-mod-row @AffixUi.Css(sm.Mod.AffixType, "-row") @cat.RowClass">
                    <span class="tm-type @AffixUi.TypeCss(sm.Mod.AffixType)">@AffixUi.Letter(sm.Mod.AffixType)</span>
                    <span class="tm-tier">T@(Pool.DisplayTier(sm.Mod, _virtualItem))</span>
                    <span class="tm-name">@sm.Mod.DisplayName</span>
                    <span class="tm-text">@sm.Mod.Text</span>
                    @for (int r = 0; r < sm.Mod.Ranges.Count; r++)
                    {
                        var range = sm.Mod.Ranges[r];
                        if (range[0] == range[1]) continue;
                        var ri = r;
                        <input type="number" class="tm-value" step="any" min="@range[0]" max="@range[1]"
                               placeholder="@ValueLabel" title="@($"{ValueLabel} ({range[0]}–{range[1]})")"
                               value="@sm.Values[ri]" @onchange="e => SetValue(sm, ri, e.Value)" />
                    }
                    @if (cat.ShortName != null)
                    {
                        <span class="tm-cat-badge @cat.BadgeClass">@cat.ShortName</span>
                    }
                    <button class="btn btn-xs tm-remove" @onclick="() => Change(() => Selection.RemoveAt(idx))">✕</button>
                </div>
            }
        </div>
    }

    <div class="add-mod-section">
        <div class="add-mod-tabs">
            @foreach (var type in new[] { AffixType.Prefix, AffixType.Suffix })
            {
                var t = type;
                <button class="btn btn-sm @(_affixType == t ? "btn-active" : "")" @onclick="() => _affixType = t">
                    + @t (@Selection.Count(t)/@Selection.Max(Draft.Rarity, t))
                </button>
            }
        </div>

        <div class="search-filter">
            <input type="text" @bind="_filter" @bind:event="oninput" placeholder="Search prefixes and suffixes..." />
        </div>
        @if (Searching)
        {
            <p class="builder-hint">Searching prefixes and suffixes; clear the search to browse by tab.</p>
        }

        <div class="mod-browser">
            @foreach (var affixType in VisibleTypes)
            {
                @foreach (var cat in Categories)
                {
                    var category = cat.Key;
                    var sectionKey = $"{category}|{affixType}";
                    var groups = FilteredGroups(category, affixType);
                    if (groups.Count == 0) continue;
                    var autoExpand = Searching && groups.Count <= AutoExpandLimit;
                    <div class="mod-category-section">
                        <div class="mod-category-header @cat.HeaderClass" @onclick="() => Toggle(_collapsed, sectionKey)">
                            <span class="cat-expand">@(_collapsed.Contains(sectionKey) ? "▸" : "▾")</span>
                            <span class="cat-label @cat.LabelClass">@cat.Label @affixType</span>
                            <span class="cat-count">@groups.Count</span>
                        </div>
                        @if (!_collapsed.Contains(sectionKey))
                        {
                            <div>
                                @foreach (var group in groups)
                                {
                                    var key = group.Key;
                                    var isAdded = Selection.HasFamily(group.Value[0].Family);
                                    var expanded = _expanded.Contains(key) != autoExpand;
                                <div class="mod-family @(isAdded ? "family-added" : "")">
                                    <div class="family-header" @onclick="() => Toggle(_expanded, key)">
                                        <span class="family-expand">@(expanded ? "▾" : "▸")</span>
                                        <span class="family-name">@GroupLabel(group.Value)</span>
                                        @foreach (var tag in group.Value.SelectMany(m => m.ModTags).Distinct().Take(3))
                                        {
                                            <span class="mod-tag" style="color: @TagColor(tag)">@tag</span>
                                        }
                                        @if (isAdded) { <span class="family-badge">added</span> }
                                    </div>
                                    @if (expanded)
                                    {
                                        <div class="family-tiers">
                                            @foreach (var mod in group.Value.OrderBy(m => Pool.DisplayTier(m, _virtualItem)))
                                            {
                                                var currentMod = mod;
                                                var selected = Selection.Contains(currentMod);
                                                var enabled = selected || Selection.CanAdd(currentMod, Draft.Rarity, Draft.ItemLevel);
                                                <button class="tier-btn @(selected ? "selected" : "") @(enabled ? "" : "disabled")"
                                                        disabled="@(!enabled)"
                                                        @onclick="() => Change(() => Selection.Toggle(currentMod, category, Draft.Rarity, Draft.ItemLevel))"
                                                        title="@(currentMod.Level > Draft.ItemLevel ? $"Requires item level {currentMod.Level}" : "")">
                                                    <span class="tier-label">T@(Pool.DisplayTier(currentMod, _virtualItem))</span>
                                                    <span class="tier-name">@currentMod.DisplayName</span>
                                                    <span class="tier-text">@currentMod.Text</span>
                                                    <span class="tier-weight" title="Estimated weight (poe2db)">@Pool.WeightForItem(currentMod, _virtualItem)</span>
                                                    <span class="tier-level">ilvl @currentMod.Level</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ItemDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Modifiers";
    /// <summary>Placeholder of the value inputs: the actual value in the composer, the minimum value in the planner.</summary>
    [Parameter] public string ValueLabel { get; set; } = "value";

    private ModSelection Selection => Draft.Selection;

    private record CategoryInfo(string Key, string Label, string HeaderClass, string LabelClass, string? ShortName, string BadgeClass, string RowClass);
    /// <summary>Categories offered in the browser.</summary>
    private static readonly CategoryInfo[] Categories =
    {
        new(ModPool.NormalCategory, "Base", "base-header", "base-label", null, "", ""),
        new(ModPool.OtherworldlyCategory, "Otherworldly", "otherworldly-header", "otherworldly-label", "OW", "cat-badge-otherworldly", "otherworldly-row"),
        new(ModPool.DesecratedCategory, "Desecrated", "desecrated-header", "desecrated-label", "Des", "cat-badge-desecrated", "desecrated-row"),
    };
    /// <summary>Categories that only appear when taken over from an existing item.</summary>
    private static readonly CategoryInfo[] LoadedOnly =
    {
        new(ModCategories.Essence, "Essence", "", "", "Ess", "cat-badge-crafted", ""),
        new(ModCategories.PerfectEssence, "Perfect Essence", "", "", "Crafted", "cat-badge-crafted", ""),
    };
    private static CategoryInfo CategoryOf(string key) => Categories.Concat(LoadedOnly).FirstOrDefault(c => c.Key == key) ?? Categories[0];

    private async Task SetValue(SelectedMod mod, int rangeIndex, object? input)
    {
        var range = mod.Mod.Ranges[rangeIndex];
        mod.Values[rangeIndex] = double.TryParse(input?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)
            ? Math.Clamp(v, range[0], range[1])
            : null;
        await Change(() => { });
    }

    private Item? _virtualItem;
    /// <summary>category -> tier group key -> mods (all tiers, not filtered by item level so the full picture is visible).</summary>
    private Dictionary<string, Dictionary<string, List<ModDef>>> _groups = new();
    private AffixType _affixType = AffixType.Prefix;
    private string _filter = "";
    private readonly HashSet<string> _expanded = new();
    private readonly HashSet<string> _collapsed = new();

    protected override void OnParametersSet()
    {
        if (Draft.Base == null) { _virtualItem = null; return; }
        if (!ReferenceEquals(Draft.Base, _virtualItem?.Base))
        {
            _expanded.Clear();
            _virtualItem = Item.FromBase(Draft.Base);
            _groups = Categories.ToDictionary(c => c.Key, c =>
                Pool.AllForBaseByCategory(_virtualItem, c.Key).GroupBy(ModTiers.TierGroupKey).ToDictionary(g => g.Key, g => g.ToList()));
        }
    }

    /// <summary>Sections whose families are expanded automatically while searching (few results).</summary>
    private const int AutoExpandLimit = 6;

    private bool Searching => !string.IsNullOrWhiteSpace(_filter);

    /// <summary>Browsing shows the selected tab's affix type; a search covers prefixes and suffixes.</summary>
    private IEnumerable<AffixType> VisibleTypes => Searching ? new[] { AffixType.Prefix, AffixType.Suffix } : new[] { _affixType };

    private List<KeyValuePair<string, List<ModDef>>> FilteredGroups(string category, AffixType type) =>
        _groups.TryGetValue(category, out var dict)
            ? dict.Where(g => g.Value[0].AffixType == type)
                  .Where(g => !Searching || g.Value.Any(m => Matches(m, _filter.Trim())))
                  .OrderBy(g => GroupLabel(g.Value))
                  .ToList()
            : new();

    private static bool Matches(ModDef m, string filter) =>
        new[] { m.Family ?? "", m.Text, m.Name }.Concat(m.ModTags).Any(s => s.Contains(filter, StringComparison.OrdinalIgnoreCase));

    private async Task Change(Action change)
    {
        change();
        Draft.Refresh();
        await OnChanged.InvokeAsync();
    }

    private static void Toggle(HashSet<string> set, string key)
    {
        if (!set.Remove(key)) set.Add(key);
    }

    /// <summary>Group label = the lowest tier's text with numbers stripped, e.g. "#% increased Spell Damage".</summary>
    private static string GroupLabel(List<ModDef> mods)
    {
        var first = mods.MinBy(m => m.Level)!;
        return string.IsNullOrWhiteSpace(first.Text) ? first.Name : ModText.StripNumbers(first.Text);
    }

    private static readonly (string Tag, string Color)[] TagColors =
    {
        ("life", "#cc4444"), ("fire", "#cc4444"), ("mana", "#6688ff"), ("cold", "#6688ff"), ("speed", "#44cc44"), ("lightning", "#ffcc44"),
        ("chaos", "#aa44cc"), ("physical", "#c8c4b8"), ("critical", "#ffdd44"), ("attribute", "#44aacc"), ("resistance", "#cc8833"),
        ("defences", "#66ccaa"), ("armour", "#66ccaa"), ("evasion", "#66ccaa"), ("energy_shield", "#66ccaa"),
        ("attack", "#cc8844"), ("caster", "#8866cc"), ("minion", "#88cc44"),
    };

    private static string TagColor(string tag) => TagColors.FirstOrDefault(t => tag.Contains(t.Tag)).Color ?? "#807c70";
}
