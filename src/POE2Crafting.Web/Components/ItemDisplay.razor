@* Displays an item in a POE-style tooltip layout *@
@inject ModPool Pool
@inject GameData Data
@inject CraftingEngine Engine
@inject IJSRuntime JS

<div class="item-box @UiFormat.RarityCss(Item.Rarity)">
    <button type="button" class="item-copy @(_copyState)" title="Copy the item text (game format, Ctrl+Alt+C style) — import it again or paste it anywhere"
            aria-label="Copy item text" @onclick="CopyText">@(_copyState switch { "copied" => "✓ Copied", "failed" => "Copy failed", _ => "⧉ Copy" })</button>
    <div class="item-header">
        <CraftIcon Url="@Data.BaseIconUrl(Item.Base)" Class="item-base-icon" />
        @if (Item.Rarity is Rarity.Rare or Rarity.Unique && Item.Name != null)
        {
            <div class="item-name">@Item.Name</div>
        }
        <div class="item-base">@Item.BaseName</div>
    </div>

    <div class="item-props">
        @if (Item.Quality > 0)
        {
            <div class="prop">Quality: <span class="value-blue">+@Item.QualityText</span></div>
        }
        <div class="prop">Item Level: <span class="value-white">@Item.ItemLevel</span></div>
    </div>

    @* augment sockets: what is socketed (rune, soul core, idol) with its effect on this item, and the free ones *@
    @if (Item.Sockets > 0 || Item.Runes.Count > 0)
    {
        <div class="item-sockets" aria-label="Augment sockets">
            @for (int s = 0; s < Math.Max(Item.Sockets, Item.Runes.Count); s++)
            {
                var rune = s < Item.Runes.Count ? Item.Runes[s] : null;
                var augment = rune != null ? Data.FindAugmentByEffect(rune, Item.Base, Item.ItemClass) : null;
                <div class="item-socket @(rune == null ? "empty" : "")" @key="s">
                    <span class="socket-slot" aria-hidden="true">
                        @if (augment != null && Data.FindCraftItem(augment.Name)?.IconUrl is { } icon)
                        {
                            <CraftIcon Url="@icon" Class="socket-icon" />
                        }
                    </span>
                    @if (rune == null)
                    {
                        <span class="socket-text">Empty socket</span>
                    }
                    else
                    {
                        <span class="socket-text">
                            @if (augment != null)
                            {
                                <span class="socket-name"><CraftItemLink Name="@augment.Name" ShowIcon="false" /></span>
                            }
                            <span class="socket-effect">@rune</span>
                        </span>
                    }
                </div>
            }
        </div>
    }

    <div class="item-separator"></div>

    @* Corruption enchantments, implicit and enchant mods *@
    @foreach (var mod in ImplicitLines)
    {
        <div class="mod-line @(mod.Kind == ModKind.CorruptedImplicit ? "corrupted-implicit" : "implicit")" title="@mod.Kind">@mod.DisplayText()</div>
    }

    @if (ImplicitLines.Any() && Item.Affixes.Any())
    {
        <div class="item-separator"></div>
    }

    @* Explicit mods *@
    @foreach (var mod in Item.Affixes.OrderBy(m => m.Affix))
    {
        var modIndex = Item.Mods.IndexOf(mod);
        var factor = Item.ValueFactor(mod);
        var enhanced = factor != 1;
        <div class="mod-line @AffixUi.Css(mod.Affix) @(mod.Kind == ModKind.Crafted ? "crafted" : "") @(mod.Fractured ? "fractured" : "") @(mod.Kind == ModKind.Desecrated ? "desecrated" : "")">
            <span class="mod-indicator" title="@ModTooltip(mod)">@AffixUi.Letter(mod.Affix)</span>
            @if (mod.Def != null && mod.Kind != ModKind.Crafted && Pool.TryDisplayTier(mod.Def, Item) is { } tier)
            {
                <span class="mod-tier" title="@mod.Def.DisplayName">T@(tier)</span>
            }
            @* text, tier range and badges wrap together in a narrow column; the level stays on the right *@
            <span class="mod-body">
                <span class="mod-text" title="@(enhanced ? $"Base value: {mod.DisplayText()}" : null)">@Item.EffectiveText(mod)</span>
                @if (!mod.Unrevealed && mod.Def != null && ModText.RangesText(mod.Def.Ranges) is { } range)
                {
                    <span class="mod-range" title="Roll range of this tier: @mod.Def.Text">(@range)</span>
                }
                @if (enhanced) { <span class="mod-badge quality-badge" title="@EnhancementTitle(mod)">@EnhancementBadge(mod)</span> }
                @if (mod.Fractured) { <span class="mod-badge fractured-badge">Fractured</span> }
                @if (mod.Kind == ModKind.Crafted) { <span class="mod-badge crafted-badge">Crafted</span> }
                @if (mod.Kind == ModKind.Desecrated) { <span class="mod-badge desecrated-badge">Desecrated</span> }
                @if (mod.Unrevealed)
                {
                    <button type="button" class="btn btn-xs reveal-toggle" aria-expanded="@(_openReveals.Contains(modIndex) ? "true" : "false")"
                            title="What this modifier can be revealed as (bone and omen used: @(mod.Reveal?.Describe() ?? "any"))"
                            @onclick="() => _openReveals.Toggle(modIndex)">
                        @(_openReveals.Contains(modIndex) ? "▾" : "▸") can become
                    </button>
                }
            </span>
            <ModLevel Mod="mod.Def" />
        </div>
        @if (mod.Unrevealed && _openReveals.Contains(modIndex))
        {
            var (exclusive, regular) = Engine.RevealOffers(Item, modIndex);
            <div class="reveal-pool">
                <div class="hint">@(mod.Reveal?.Describe() is { Length: > 0 } context ? $"{context} — " : "")% = chance to be offered at the Well of Souls; counts as level 1 for Omen of Whittling until revealed</div>
                @if (exclusive.Count + regular.Count > RevealSearchFrom)
                {
                    <SearchBox @bind-Value="_revealFilter" Placeholder="@($"Search {exclusive.Count + regular.Count} possible modifiers (name, text, tag)...")" />
                }
                @foreach (var (group, title) in new[] { (Matching(exclusive), Engine.RevealExclusiveLabel(Item, modIndex)), (Matching(regular), "Other options — regular modifiers") })
                {
                    if (group.Count == 0) continue;
                    <div class="reveal-group-title">@title — @group.Count</div>
                    <ModOptionList Candidates="group" Item="Item" AutoExpand="@(_revealFilter.Length > 0)" />
                }
            </div>
        }
    }

    @* Lines that hold no prefix/suffix slot: a unique's own modifiers, or text the data store does not have *@
    @foreach (var mod in Item.Mods.Where(m => m.Kind.OccupiesSlot() && !m.IsAffix))
    {
        <div class="mod-line @(mod.Def == null ? "unmatched" : "unique-mod")" title="@LineTitle(mod)">
            <span class="mod-body">
                <span class="mod-text">@Item.EffectiveText(mod)</span>
                @if (mod.Def is { } def && ModText.RangesText(def.Ranges) is { } range)
                {
                    <span class="mod-range" title="Range of this unique: @def.Text">(@range)</span>
                }
            </span>
        </div>
    }
    @if (Item.Mods.Any(m => m.Kind.OccupiesSlot() && !m.IsAffix && m.Def == null))
    {
        <div class="item-note">Lines without a range are not part of the modifier data.</div>
    }

    <div class="item-footer">
        @if (Item.Rarity != Rarity.Unique)
        {
            <div class="affix-count">
                Affixes: @Item.PrefixCount P / @Item.SuffixCount S
                @if (Item.Rarity is Rarity.Magic or Rarity.Rare)
                {
                    <span class="max-info">(max @Rules.MaxAffixes(Item, Item.Rarity, AffixType.Prefix)/@Rules.MaxAffixes(Item, Item.Rarity, AffixType.Suffix))</span>
                }
            </div>
        }
        @if (Item.Corrupted) { <div class="flag corrupted">@(Item.TwiceCorrupted ? "Twice Corrupted" : "Corrupted")</div> }
        @if (Item.Mirrored) { <div class="flag mirrored">Mirrored</div> }
        @if (Item.Sanctified) { <div class="flag sanctified">Sanctified</div> }
        @if (Item.Foreseeing) { <div class="flag foreseeing">Foreseeing</div> }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = null!;

    private SimAssumptions Rules => Data.Config.Assumptions;

    /// <summary>"", "copied" or "failed": feedback of the copy button for a moment.</summary>
    private string _copyState = "";

    private async Task CopyText()
    {
        var text = ItemTextWriter.ToText(Item, mod => Pool.DisplayTier(mod, Item));
        _copyState = await JS.InvokeAsync<bool>("copyText", text) ? "copied" : "failed";
        StateHasChanged();
        await Task.Delay(1500);
        _copyState = "";
    }

    /// <summary>Unrevealed mods (by index) whose possible reveals are shown.</summary>
    private readonly HashSet<int> _openReveals = new();
    /// <summary>From this many possible reveals on, the pool gets a search box.</summary>
    private const int RevealSearchFrom = 10;
    /// <summary>Search over what an unrevealed modifier can become (the pool runs into the hundreds).</summary>
    private string _revealFilter = "";

    /// <summary>The candidates matching the search; the shown chances stay the real ones.</summary>
    private List<ModCandidate> Matching(IEnumerable<ModCandidate> candidates) =>
        candidates.Where(c => TextSearch.Matches(_revealFilter, new[] { c.Mod.DisplayName, c.Mod.Text, c.Mod.Family }.Concat(c.Mod.ModTags))).ToList();

    /// <summary>Another item (or state) closes the lists: mod indices refer to the shown item.</summary>
    private Item? _shownItem;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_shownItem, Item)) return;
        _shownItem = Item;
        _openReveals.Clear();
        _revealFilter = "";
    }

    private IEnumerable<ItemMod> ImplicitLines => Item.Mods.Where(m => m.Kind.IsImplicitLine()).OrderBy(m => m.Kind == ModKind.CorruptedImplicit ? 0 : 1);

    /// <summary>"+34% Q" (catalyst quality), "+17% M" (magnitude modifiers) or "+51%" (both).</summary>
    private string EnhancementBadge(ItemMod mod)
    {
        int quality = Item.QualityEnhances(mod) ? Item.Quality : 0;
        double magnitude = ModMagnitudes.BonusFor(Item, mod);
        var total = UiFormat.Coordinate(quality + magnitude);
        return quality > 0 && magnitude > 0 ? $"+{total}%" : quality > 0 ? $"+{total}% Q" : $"+{total}% M";
    }

    private string EnhancementTitle(ItemMod mod)
    {
        var parts = new List<string>();
        if (Item.QualityEnhances(mod)) parts.Add($"{Item.QualityText} catalyst quality");
        if (ModMagnitudes.BonusFor(Item, mod) is > 0 and var magnitude) parts.Add($"{UiFormat.Coordinate(magnitude)}% from \"increased … Modifier magnitudes\" (assumption: added to quality)");
        return $"Values increased by {string.Join(" + ", parts)} — base: {mod.DisplayText()}";
    }

    /// <summary>Why a line has no tier: a unique rolls its own modifiers, everything else is simply not in the modifier data.</summary>
    private static string LineTitle(ItemMod mod) => mod.Def != null
        ? "The unique grants this modifier itself: it rolls in the unique's own range and has no tier."
        : "Not part of the modifier data, so it has no range and no tier.";

    private string ModTooltip(ItemMod mod)
    {
        var parts = new List<string> { mod.Affix.ToString() };
        if (mod.Def != null)
        {
            parts.Add($"\"{mod.Def.DisplayName}\"");
            if (mod.Kind != ModKind.Crafted && Pool.TryDisplayTier(mod.Def, Item) is { } tier) parts.Add($"Tier {tier}/{Pool.DisplayTierCount(mod.Def, Item)}");
            parts.Add($"ilvl {mod.Def.Level}");
        }
        if (mod.SourceName != null) parts.Add($"Source: {mod.SourceName}");
        return string.Join(" · ", parts);
    }
}
