@* Displays an item in a POE-style tooltip layout *@

<div class="item-box rarity-@Item.Rarity.ToString().ToLower()">
    <div class="item-header">
        @if (Item.Rarity is Rarity.Rare or Rarity.Unique && Item.Name != null)
        {
            <div class="item-name">@Item.Name</div>
        }
        <div class="item-base">@Item.BaseName</div>
    </div>

    <div class="item-props">
        @if (Item.Quality > 0)
        {
            <div class="prop">Quality: <span class="value-blue">+@(Item.Quality)%@(Item.QualityType != null ? $" ({Item.QualityType})" : "")</span></div>
        }
        @if (Item.Sockets > 0)
        {
            <div class="prop">Sockets: @Item.Sockets</div>
        }
        <div class="prop">Item Level: <span class="value-white">@Item.ItemLevel</span></div>
    </div>

    <div class="item-separator"></div>

    @* Implicit mods *@
    @foreach (var mod in Item.Mods.Where(m => m.Kind == ModKind.Implicit))
    {
        <div class="mod-line implicit" title="Implicit">@mod.DisplayText()</div>
    }

    @if (Item.Mods.Any(m => m.Kind == ModKind.Implicit) && Item.Affixes.Any())
    {
        <div class="item-separator"></div>
    }

    @* Explicit mods *@
    @foreach (var mod in Item.Mods.Where(m => Item.IsAffixKind(m.Kind)).OrderBy(m => m.Affix))
    {
        <div class="mod-line @(mod.Affix == AffixType.Prefix ? "prefix" : "suffix") @(mod.Kind == ModKind.Crafted ? "crafted" : "") @(mod.Fractured ? "fractured" : "") @(mod.Kind == ModKind.Desecrated ? "desecrated" : "")">
            <span class="mod-indicator" title="@ModTooltip(mod)">@(mod.Affix == AffixType.Prefix ? "P" : "S")</span>
            @if (mod.Def != null)
            {
                <span class="mod-tier" title="@mod.Def.Name">T@(mod.Def.Tier)</span>
            }
            <span class="mod-text">@mod.DisplayText()</span>
            @if (mod.Fractured) { <span class="mod-badge fractured-badge">Fractured</span> }
            @if (mod.Kind == ModKind.Crafted) { <span class="mod-badge crafted-badge">Crafted</span> }
            @if (mod.Kind == ModKind.Desecrated) { <span class="mod-badge desecrated-badge">Desecrated</span> }
        </div>
    }

    @* Corrupted implicit mods *@
    @foreach (var mod in Item.Mods.Where(m => m.Kind == ModKind.CorruptedImplicit))
    {
        <div class="mod-line corrupted-implicit">@mod.DisplayText()</div>
    }

    <div class="item-footer">
        <div class="affix-count">
            Affixes: @Item.PrefixCount P / @Item.SuffixCount S
            @if (Item.Rarity == Rarity.Magic) { <span class="max-info">(max 1/1)</span> }
            @if (Item.Rarity == Rarity.Rare) { <span class="max-info">(max 3/3)</span> }
        </div>
        @if (Item.Corrupted) { <div class="flag corrupted">Corrupted</div> }
        @if (Item.Mirrored) { <div class="flag mirrored">Mirrored</div> }
        @if (Item.Sanctified) { <div class="flag sanctified">Sanctified</div> }
        @if (Item.Foreseeing) { <div class="flag foreseeing">Foreseeing</div> }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = null!;

    private string ModTooltip(ItemMod mod)
    {
        var parts = new List<string>();
        parts.Add(mod.Affix == AffixType.Prefix ? "Prefix" : "Suffix");
        if (mod.Def != null) { parts.Add($"\"{mod.Def.Name}\""); parts.Add($"Tier {mod.Def.Tier}/{mod.Def.TierCount}"); parts.Add($"ilvl {mod.Def.Level}"); }
        if (mod.SourceName != null) parts.Add($"Source: {mod.SourceName}");
        return string.Join(" · ", parts);
    }
}
