@* Sortable table column header: click to sort by it, click again to reverse (the arrow shows the direction of the active column). *@

<button type="button" class="market-sort @(Active ? "active" : "")" @onclick="OnClick">@Label@(Active ? (Descending ? " ▾" : " ▴") : "")</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>The table is sorted by this column.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
