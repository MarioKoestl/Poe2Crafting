@inject CraftingSession Session
@inject GameData Data

<div class="item-composer">
    <div class="composer-header">
        <h3>Compose Item</h3>
        <button class="btn btn-xs" @onclick="OnCancel">Cancel</button>
    </div>

    <BaseItemForm @bind-ItemClass="_itemClass" @bind-BaseName="BaseName" @bind-Rarity="ComposeRarity" @bind-ItemLevel="ItemLevel" RarityLabel="Rarity" />

    @if (_base != null)
    {
        <ModBrowser Base="_base" ItemLevel="_itemLevel" Rarity="_rarity" Selection="_selection" OnChanged="BuildPreviewItem" />

        @if (_previewItem != null)
        {
            <div class="composer-preview">
                <h4>Preview</h4>
                <ItemDisplay Item="_previewItem" />
            </div>
        }

        <div class="builder-actions">
            <button class="btn btn-primary btn-execute" @onclick="DoCompose">Set as Current Item</button>
            <button class="btn" @onclick="OnCancel">Cancel</button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnComposed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _itemClass = "";
    private string _baseName = "";
    private BaseItem? _base;
    private int _itemLevel = 82;
    private Rarity _rarity = Rarity.Rare;
    private ModSelection _selection = null!;
    private Item? _previewItem;

    protected override void OnInitialized() => _selection = new ModSelection(Data.Config.Assumptions);

    private string BaseName
    {
        get => _baseName;
        set
        {
            _baseName = value;
            _base = string.IsNullOrEmpty(value) ? null : Data.FindBase(value);
            _selection.Clear();
            BuildPreviewItem();
        }
    }

    private int ItemLevel
    {
        get => _itemLevel;
        set { _itemLevel = Math.Clamp(value, 1, 100); _selection.Enforce(_rarity, _itemLevel); BuildPreviewItem(); }
    }

    private Rarity ComposeRarity
    {
        get => _rarity;
        set { _rarity = value; _selection.Enforce(_rarity, _itemLevel); BuildPreviewItem(); }
    }

    private void BuildPreviewItem() => _previewItem = _base != null ? _selection.BuildItem(_base, _rarity, _itemLevel) : null;

    private async Task DoCompose()
    {
        if (_base == null) return;
        Session.SetItem(_selection.BuildItem(_base, _rarity, _itemLevel), "Composed");
        if (Session.LastError == null) await OnComposed.InvokeAsync();
    }

    private async Task OnCancel() => await OnCancelled.InvokeAsync();
}
