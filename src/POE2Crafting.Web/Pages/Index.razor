@page "/"
@inject CraftingSession Session
@inject GameData Data

@* Desktop: every column/pane is its own (single) scroll area; narrow screens stack everything and the page scrolls. *@
<div class="crafting-page @(_composing ? "composing" : "")">
    @* ---- LEFT: Item Panel ---- *@
    <section class="item-panel panel">
        <div class="panel-header">
            <h2>@(!_composing ? "Item" : _editing ? "Edit Item" : "New Item")</h2>
            <div class="item-actions">
                @if (_composing)
                {
                    <button class="btn btn-sm" @onclick="OnComposeCancelled">Back to Item</button>
                }
                else
                {
                    @if (Session.CurrentItem != null)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => StartCompose(edit: true)" title="Change modifiers, values, rarity or item level of this item">Edit</button>
                    }
                    <button class="btn btn-sm" @onclick="() => StartCompose(edit: false)" title="Compose a new item from a base">New</button>
                    <button class="btn btn-sm" @onclick="ShowImport">Import</button>
                    <button class="btn btn-sm" @onclick="ShowSaveLoad">Save / Load</button>
                }
            </div>
        </div>

        <div class="panel-body">
            @if (Session.LastError != null)
            {
                <div class="error-banner">@Session.LastError</div>
            }

            @if (_composing)
            {
                <ItemComposer Edit="_editing" OnComposed="OnItemReplaced" OnCancelled="OnComposeCancelled" />
            }
            else
            {
                @if (Session.CurrentItem != null)
                {
                    <ItemDisplay Item="Session.CurrentItem" />
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">◇</div>
                        <p>No item loaded.</p>
                        <p class="empty-hint">Import an item from the game (Ctrl+Alt+C text) or compose one with modifiers.</p>
                    </div>
                }

                @if (Session.History.Count > 0)
                {
                    <div class="history-section">
                        <h3 class="section-title">
                            Crafting History
                            <button class="btn btn-xs" @onclick="Undo" disabled="@(Session.History.Count <= 1)">Undo</button>
                        </h3>
                        <div class="history-list">
                            @foreach (var entry in Session.History.AsEnumerable().Reverse())
                            {
                                <div class="history-entry">
                                    <span class="history-action"><CraftText Text="@entry.Action" /></span>
                                    <span class="history-summary" title="@entry.Summary">@entry.Summary</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    @* ---- RIGHT: Mode Tabs + two panes ---- *@
    <section class="crafting-panel panel">
        <div class="mode-tabs">
            <button class="mode-tab @(_mode == Mode.Simulator ? "active" : "")" @onclick="() => _mode = Mode.Simulator">Simulator</button>
            <button class="mode-tab @(_mode == Mode.Planner ? "active" : "")" @onclick="() => _mode = Mode.Planner">Crafting Planner</button>
        </div>

        @if (_mode == Mode.Simulator)
        {
            @if (Session.CurrentItem != null)
            {
                <div class="workspace">
                    <div class="pane">
                        <RevealPanel OnChanged="StateHasChanged" />
                        <CurrencySelector OnCurrencySelected="OnCurrencySelected" />
                    </div>
                    <div class="pane">
                        @if (_selectedAction != null)
                        {
                            <PreviewPanel Action="_selectedAction" OnExecute="OnExecute" />
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-icon">⟡</div>
                                <p>Select a currency</p>
                                <p class="empty-hint">Its probabilities appear here; roll randomly or choose the outcome.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">◇</div>
                    <p>Load an item to see available currencies.</p>
                </div>
            }
        }
        else @* Planner Mode *@
        {
            <div class="workspace">
                <div class="pane"><ItemBuilder OnPathsFound="OnPathsFound" /></div>
                <div class="pane"><PlannerPanel @ref="_plannerPanel" /></div>
            </div>
        }
    </section>
</div>

@* ---- Modals ---- *@
@if (_showImport)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation>
            <h3>Import Item</h3>
            <p>Paste the in-game Ctrl+Alt+C text:</p>
            <textarea @bind="_importText" @bind:event="oninput" rows="20" placeholder="Item Class: Staves&#10;Rarity: Rare&#10;..."></textarea>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="DoImport">Import</button>
                <button class="btn" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showSaveLoad)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal modal-wide" @onclick:stopPropagation>
            <h3>Save / Load Project</h3>
            <div class="save-section">
                <h4>Save Current</h4>
                <input type="text" @bind="Session.ProjectName" placeholder="Project name" />
                <button class="btn btn-primary" @onclick="DoSave">Download Project JSON</button>
            </div>
            <div class="load-section">
                <h4>Load Project</h4>
                <InputFile OnChange="DoLoad" accept=".json" />
            </div>
            <div class="modal-actions">
                <button class="btn" @onclick="CloseModals">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private enum Mode { Simulator, Planner }

    private Mode _mode = Mode.Simulator;
    private bool _showImport, _showSaveLoad;
    private bool _composing, _editing;
    private string _importText = "";
    private CraftAction? _selectedAction;
    private PlannerPanel? _plannerPanel;

    private void ShowImport() { CloseModals(); _showImport = true; }
    private void ShowSaveLoad() { CloseModals(); _showSaveLoad = true; }
    private void CloseModals() { _showImport = false; _showSaveLoad = false; }

    /// <summary>Open the composer: a new item, or the current item for editing.</summary>
    private void StartCompose(bool edit)
    {
        CloseModals();
        _editing = edit;
        _composing = true;
    }

    /// <summary>A different item (compose, edit, import, load, undo) invalidates the selected currency preview.</summary>
    private void OnItemReplaced()
    {
        _composing = false;
        _selectedAction = null;
        CloseModals();
    }

    private void OnComposeCancelled() => _composing = false;

    private void DoImport()
    {
        if (string.IsNullOrWhiteSpace(_importText)) return;
        if (!Session.ImportItem(_importText)) return;
        _importText = "";
        OnItemReplaced();
    }

    private void OnCurrencySelected(CraftAction action) => _selectedAction = action;

    private void OnExecute(ManualChoice? choice)
    {
        if (_selectedAction != null) Session.Execute(_selectedAction, choice);
    }

    private void Undo()
    {
        Session.Undo();
        OnItemReplaced();
    }

    private void OnPathsFound(ItemBuilder.PlannerResult result)
    {
        _plannerPanel?.ShowResults(result);
    }

    [Inject] IJSRuntime JS { get; set; } = null!;

    private async Task DoSave()
    {
        var project = Session.ToProject();
        var json = System.Text.Json.JsonSerializer.Serialize(project, GameData.JsonOptions);
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"{(Session.ProjectName ?? "project").Replace(" ", "_")}.json";
        await JS.InvokeVoidAsync("downloadFile", fileName, base64);
    }

    private async Task DoLoad(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var project = await System.Text.Json.JsonSerializer.DeserializeAsync<CraftingProject>(stream, GameData.JsonOptions);
            if (project != null) { Session.LoadProject(project); OnItemReplaced(); }
            else Session.SetError("Load failed: the file is empty.");
        }
        catch (Exception ex) { Session.SetError($"Load failed: {ex.Message}"); }
    }
}
