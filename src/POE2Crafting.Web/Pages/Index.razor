@page "/"
@inject CraftingSession Session
@inject PlannerState Planner

@* Desktop: every column/pane is its own (single) scroll area; narrow screens stack everything and the page scrolls. *@
<div class="crafting-page @(_composing ? "composing" : "")">
    @* ---- LEFT: Item Panel ---- *@
    <section class="item-panel panel">
        <div class="panel-header">
            <h2>@(!_composing ? "Item" : _editing ? "Edit Item" : "New Item")</h2>
            <div class="item-actions">
                @if (_composing)
                {
                    <button class="btn btn-sm" @onclick="OnComposeCancelled">Back to Item</button>
                }
                else
                {
                    @if (Session.CurrentItem != null)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => StartCompose(edit: true)" title="Change modifiers, values, rarity or item level of this item">Edit</button>
                    }
                    <button class="btn btn-sm" @onclick="() => StartCompose(edit: false)" title="Compose a new item from a base">New</button>
                    <button class="btn btn-sm" @onclick="ShowImport">Import</button>
                }
            </div>
        </div>

        <div class="panel-body">
            @if (!_composing)
            {
                <ProjectPanel OnChanged="OnItemReplaced" />
            }

            @if (Session.LastError != null)
            {
                <div class="error-banner" role="alert">@Session.LastError</div>
            }

            @if (_composing)
            {
                <ItemComposer Edit="_editing" OnComposed="OnItemReplaced" OnCancelled="OnComposeCancelled" />
            }
            else
            {
                @if (Session.CurrentItem != null)
                {
                    <ItemDisplay Item="Session.CurrentItem" />
                }
                else
                {
                    <EmptyState Hint="Import an item from the game (Ctrl+Alt+C text) or compose one with modifiers.">No item loaded.</EmptyState>
                }

                @if (Session.History.Count > 0)
                {
                    <div class="history-section">
                        <h3 class="section-title">
                            Crafting History
                            <button class="btn btn-xs" @onclick="Undo" disabled="@(Session.History.Count <= 1)">Undo</button>
                        </h3>
                        <div class="history-list">
                            @for (int i = Session.History.Count - 1; i >= 0; i--)
                            {
                                var index = i;
                                var entry = Session.History[i];
                                <div class="history-entry" @key="entry">
                                    <span class="history-action"><CraftText Text="@entry.Action" /></span>
                                    <span class="history-summary" title="@entry.Summary">@entry.Summary</span>
                                    @if (_editingNote == index)
                                    {
                                        <div class="history-note-edit">
                                            <textarea rows="2" placeholder="Why this step? (shown in a saved guide)" aria-label="Note for this step"
                                                      @bind="_noteText" @bind:event="oninput" @onkeydown="e => OnNoteKey(e, index)"></textarea>
                                            <button class="btn btn-xs btn-primary" @onclick="() => SaveNote(index)">Save</button>
                                            <button class="btn btn-xs" @onclick="() => _editingNote = null">Cancel</button>
                                        </div>
                                    }
                                    else if (entry.Note is { Length: > 0 } note)
                                    {
                                        <button class="history-note" title="Edit the note" @onclick="() => EditNote(index, note)">@note</button>
                                    }
                                    else
                                    {
                                        <button class="history-note history-note-add" title="Why did you do this step? The note is saved with the project and shown in a saved guide"
                                                @onclick="() => EditNote(index, string.Empty)">＋ note</button>
                                    }
                                </div>
                            }
                        </div>
                        <button class="btn btn-sm history-save" @onclick="ShowSaveGuide" disabled="@(!Session.CanSaveAsGuide)"
                                title="@(Session.CanSaveAsGuide ? "Save this crafting path (base, currencies, every step) as a guide to reuse it later" : "Apply a currency first")">
                            Save as Guide
                        </button>
                    </div>
                }
            }
        </div>
    </section>

    @* ---- RIGHT: Mode Tabs + two panes ---- *@
    <section class="crafting-panel panel">
        <div class="mode-tabs" role="tablist">
            @foreach (var mode in Enum.GetValues<Mode>())
            {
                var m = mode;
                <button role="tab" aria-selected="@(_mode == m ? "true" : "false")" class="mode-tab @(_mode == m ? "active" : "")" @onclick="() => _mode = m">@TabLabel(m)</button>
            }
        </div>

        <div class="workspace">
            @switch (_mode)
            {
                case Mode.Simulator when Session.CurrentItem != null:
                    <div class="pane">
                        <InstillPanel OnChanged="StateHasChanged" />
                        <CurrencySelector @bind-Selected="_selectedAction" />
                    </div>
                    <div class="pane">
                        @if (_selectedAction != null)
                        {
                            <PreviewPanel Action="_selectedAction" OnExecute="OnExecute" />
                        }
                        else
                        {
                            <EmptyState Icon="⟡" Hint="Its probabilities appear here; roll randomly or choose the outcome.">Select a currency</EmptyState>
                        }
                    </div>
                    break;
                case Mode.Simulator:
                    <div class="pane"><EmptyState>Load an item to see available currencies.</EmptyState></div>
                    break;
                case Mode.Planner:
                    <div class="pane"><ItemBuilder /></div>
                    <div class="pane"><PlannerPanel /></div>
                    break;
                default:
                    <div class="pane"><GuideList /></div>
                    <div class="pane"><GuideDetail OnStartItemLoaded="OnGuideItemLoaded" /></div>
                    break;
            }
        </div>
    </section>
</div>

@* ---- Modals ---- *@
@if (_showImport)
{
    <Modal Title="Import Item" ConfirmLabel="Import" OnConfirm="DoImport" OnClose="CloseModals">
        <p>Paste the in-game Ctrl+Alt+C text:</p>
        <textarea @bind="_importText" @bind:event="oninput" rows="20" placeholder="@ImportPlaceholder"></textarea>
    </Modal>
}

@if (_showSaveGuide && Session.CurrentItem is { } guideItem)
{
    <Modal Title="Save as Guide" ConfirmLabel="Save" OnConfirm="SaveGuide" OnClose="CloseModals">
        <p>@Session.History[0].Item.BaseName → @guideItem.Title · @UiFormat.Plural(Session.History.Count - 1, "step"). The guide appears under <strong>My Guides</strong> in the Guides tab.</p>
        <label for="guide-name">Name</label>
        <input id="guide-name" type="text" @bind="_guideName" @bind:event="oninput" placeholder="@($"{Session.History[0].Item.BaseName} → {guideItem.Title}")" />
        <label for="guide-notes">Notes (optional)</label>
        <textarea id="guide-notes" @bind="_guideNotes" @bind:event="oninput" rows="4" placeholder="What the craft is for, what to watch out for..."></textarea>
    </Modal>
}

@code {
    private enum Mode { Simulator, Planner, Guides }

    private static string TabLabel(Mode mode) => mode == Mode.Planner ? "Crafting Planner" : mode.ToString();

    /// <summary>Multi-line example of the item text (Razor would escape an entity in the attribute).</summary>
    private const string ImportPlaceholder = "Item Class: Staves\nRarity: Rare\n...";

    private Mode _mode = Mode.Simulator;
    private bool _showImport, _showSaveGuide;
    private string _guideName = "", _guideNotes = "";
    private bool _composing, _editing;
    private string _importText = "";
    private CraftAction? _selectedAction;

    private void ShowImport() { CloseModals(); _showImport = true; }
    private void CloseModals() => _showImport = _showSaveGuide = false;

    private void ShowSaveGuide()
    {
        CloseModals();
        _guideName = _guideNotes = "";
        _showSaveGuide = true;
    }

    /// <summary>Save the history as a guide and show it in the Guides tab.</summary>
    private void SaveGuide()
    {
        if (Session.SaveAsGuide(_guideName, _guideNotes) is not { } id) return;
        CloseModals();
        Planner.SelectGuide(id);
        _mode = Mode.Guides;
    }

    /// <summary>Open the composer: a new item, or the current item for editing.</summary>
    private void StartCompose(bool edit)
    {
        CloseModals();
        _editing = edit;
        _composing = true;
    }

    /// <summary>A different item (compose, edit, import, load, undo, guide) invalidates the selected currency and omens.</summary>
    private void OnItemReplaced()
    {
        _composing = false;
        _selectedAction = null;
        CloseModals();
    }

    private void OnComposeCancelled() => _composing = false;

    private void DoImport()
    {
        if (string.IsNullOrWhiteSpace(_importText)) return;
        if (!Session.ImportItem(_importText)) return;
        _importText = "";
        OnItemReplaced();
    }

    private void OnExecute(ManualChoice? choice)
    {
        if (_selectedAction != null) Session.Execute(_selectedAction, choice);
    }

    /// <summary>The history step whose note is being edited, and the text.</summary>
    private int? _editingNote;
    private string _noteText = "";

    private void EditNote(int index, string note)
    {
        _editingNote = index;
        _noteText = note;
    }

    private void SaveNote(int index)
    {
        Session.SetNote(index, _noteText);
        _editingNote = null;
    }

    private void OnNoteKey(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Escape") _editingNote = null;
        else if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) SaveNote(index);
    }

    private void Undo()
    {
        Session.Undo();
        OnItemReplaced();
    }

    /// <summary>A guide's starting item is now the current item: craft along in the simulator.</summary>
    private void OnGuideItemLoaded()
    {
        OnItemReplaced();
        _mode = Mode.Simulator;
    }
}
