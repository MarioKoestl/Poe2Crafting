@page "/builds"
@implements IDisposable
@inject NinjaBuildsService Ninja
@inject BuildsState State

<PageTitle>Builds · POE2 Crafting</PageTitle>

<div class="single-page">
    <section class="panel">
        <div class="panel-header">
            <h2>Builds</h2>
            <div class="market-controls">
                @if (State.Snapshots.Count > 0)
                {
                    <select class="market-select" value="@State.Snapshot?.Url" aria-label="League" @onchange="e => SelectLeague(e.Value?.ToString())">
                        @foreach (var snapshot in State.Snapshots)
                        {
                            <option value="@snapshot.Url">@snapshot.Name</option>
                        }
                    </select>
                }
                @if (State.Filter != BuildFilter.None)
                {
                    <span class="build-filter-chips">
                        @if (State.Filter.Skill is { } skill)
                        {
                            <button class="btn btn-sm btn-active" title="Remove the filter" @onclick="() => SetFilter(State.Filter with { Skill = null })">@skill ✕</button>
                        }
                        @if (State.Filter.Class is { } className)
                        {
                            <button class="btn btn-sm btn-active" title="Remove the filter" @onclick="() => SetFilter(State.Filter with { Class = null })">@className ✕</button>
                        }
                        @if (State.Filter.Item is { } itemName)
                        {
                            <button class="btn btn-sm btn-active" title="Remove the filter" @onclick="() => SetFilter(State.Filter with { Item = null })">@itemName ✕</button>
                        }
                    </span>
                }
                <span class="market-status">
                    @if (State.Overview != null)
                    {
                        @($"{State.Overview.Total:N0} characters · data: poe.ninja")
                    }
                </span>
            </div>
        </div>

        @if (_error != null)
        {
            <div class="error-banner builds-error" role="alert">@_error</div>
        }

        <div class="workspace builds-workspace">
            <div class="pane">
                @if (State.Overview == null)
                {
                    <EmptyState Icon="⟳">@(_loading ? "Loading builds from poe.ninja…" : "No build data.")</EmptyState>
                }
                else
                {
                    <h3 class="section-title">Top builds <span class="count-pill">of the top @State.Overview.Characters.Count characters</span></h3>
                    @if (State.Overview.TopBuilds.Count == 0)
                    {
                        <p class="hint">No build information for this selection.</p>
                    }
                    else
                    {
                        <BuildShareList Entries="TopBuilds(State.Overview)" Total="State.Overview.Characters.Count" Limit="TopBuildCount" ShowType="true"
                                        Label="build"
                                        OnSelect="build => SetFilter(State.Filter with { Skill = build?.Name, Class = build?.Type })" />
                    }

                    <h3 class="section-title">Main skills <span class="count-pill">click to filter</span></h3>
                    <BuildShareList Entries="State.Overview.Skills" Total="State.Overview.Total" Selected="@State.Filter.Skill" Label="skill" OnSelect="skill => SetFilter(State.Filter with { Skill = skill?.Name })" />

                    <h3 class="section-title">Ascendancies</h3>
                    <BuildShareList Entries="State.Overview.Classes" Total="State.Overview.Total" Selected="@State.Filter.Class" Label="ascendancy" OnSelect="c => SetFilter(State.Filter with { Class = c?.Name })" Limit="10" />

                    <h3 class="section-title">Rare item slots <span class="count-pill">characters wearing a rare</span></h3>
                    <BuildShareList Entries="State.Overview.RareSlots.ToList()" Total="State.Overview.Total" Limit="20" Selected="@State.Filter.Item" Label="slot" OnSelect="item => SetFilter(State.Filter with { Item = item?.Name })" />

                    <h3 class="section-title">Uniques</h3>
                    <BuildShareList Entries="State.Overview.Uniques.ToList()" Total="State.Overview.Total" Limit="15" ShowType="true" Selected="@State.Filter.Item" Label="unique" OnSelect="item => SetFilter(State.Filter with { Item = item?.Name })" />
                }
            </div>

            <div class="pane">
                <h3 class="pane-title">@State.Filter</h3>
                <div class="detail-tabs">
                    <button class="btn btn-sm @(State.Tab == BuildsTab.Items ? "btn-active" : "")" @onclick="() => State.Tab = BuildsTab.Items">Rare items to craft</button>
                    <button class="btn btn-sm @(State.Tab == BuildsTab.Builds ? "btn-active" : "")" @onclick="() => State.Tab = BuildsTab.Builds">Builds</button>
                </div>
                <p class="hint">
                    @if (State.Tab == BuildsTab.Items)
                    {
                        <text>
                            Downloads the top characters of this selection from poe.ninja and groups their rare equipment and jewels by item class:
                            the bases they use, the modifiers with tiers and rolls, and the items themselves (open one in the simulator to plan it).
                        </text>
                    }
                    else
                    {
                        <text>The sampled characters themselves: ascendancy, skills and every piece they wear, rares and uniques alike.</text>
                    }
                </p>
                <div class="builds-analyse">
                    <label for="sample-size">Characters</label>
                    <select id="sample-size" class="market-select" value="@State.SampleSize" @onchange="e => SetSampleSize(e.Value?.ToString())">
                        @foreach (var size in SampleSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" @onclick="StartAnalysis" disabled="@(State.Snapshot == null || _job?.IsRunning == true)">
                        @(_job?.Result != null ? "Analysed" : "Analyse")
                    </button>
                    @if (_job?.IsRunning == true)
                    {
                        <span class="market-status">Loading @_job.Progress…</span>
                    }
                    else if (_job?.FinishedAt is { } finished)
                    {
                        <span class="market-status">@UiFormat.Plural(_job.Result!.Characters, "character") · @finished.ToString("HH:mm")</span>
                    }
                </div>

                @if (_job?.Error is { } jobError)
                {
                    <div class="error-banner" role="alert">@jobError</div>
                }
                @if (_job?.Result is { } result && State.Snapshot != null)
                {
                    var league = State.Snapshot.Url;
                    @if (State.Filter.Item is { } wanted)
                    {
                        var worn = result.Builds.SelectMany(c => c.Matching(wanted).Select(p => (Character: c, Piece: p))).ToList();
                        <section class="wanted-item">
                            <div class="section-title">
                                @wanted
                                <span class="count-pill">@worn.Select(w => w.Character).Distinct().Count() of @UiFormat.Plural(result.Characters, "sampled character")</span>
                            </div>
                            @if (worn.Count == 0)
                            {
                                <p class="hint">None of the sampled characters wears it. poe.ninja counts more characters than the sample, so raise the sample size and analyse again.</p>
                            }
                            @foreach (var (character, piece) in worn.Take(_allWanted ? int.MaxValue : WantedLimit))
                            {
                                <GearRow @key="piece" Piece="piece" Character="character" LeagueSlug="@league" Highlight="true" StartOpen="@(piece == worn[0].Piece)" />
                            }
                            @if (worn.Count > WantedLimit)
                            {
                                <button class="btn btn-xs" @onclick="() => _allWanted = !_allWanted">@(_allWanted ? "Fewer" : $"All {worn.Count}")</button>
                            }
                        </section>
                    }

                    @if (State.Tab == BuildsTab.Items)
                    {
                        @if (result.Classes.Count == 0)
                        {
                            <EmptyState>No rare items found.</EmptyState>
                        }
                        else
                        {
                            <SearchBox @bind-Value="State.ClassSearch" Placeholder="@($"Search {UiFormat.Plural(result.Classes.Count, "item class", "item classes")} and their bases...")" />
                        }
                        var classes = result.Classes.Where(Matches).ToList();
                        @if (result.Classes.Count > 0 && classes.Count == 0)
                        {
                            <p class="hint">No item class matches the search.</p>
                        }
                        @foreach (var demand in classes)
                        {
                            <ItemClassDemandCard @key="demand.ItemClass" Demand="demand" Characters="result.Characters" LeagueSlug="@league"
                                                 Expanded="State.ExpandedClasses.Contains(demand.ItemClass)" ExpandedChanged="open => ToggleClass(demand.ItemClass, open)"
                                                 OnSelectBuild="SelectBuild" />
                        }
                        <p class="hint market-notes">
                            Sample: the first characters poe.ninja lists for this selection (highest level first), cached 6 hours. Modifiers are matched against the simulator's data like an
                            imported item; tiers are those of each item's own base. Runes, uniques, flasks and charms are not counted.
                        </p>
                    }
                    else
                    {
                        <SearchBox @bind-Value="State.CharacterSearch" Placeholder="@($"Search {UiFormat.Plural(result.Builds.Count, "build")} (character, ascendancy, skill, item)...")" />
                        var builds = result.Builds.Where(MatchesBuild).ToList();
                        @if (builds.Count == 0)
                        {
                            <EmptyState>@(result.Builds.Count == 0 ? "No characters loaded." : "No build matches the search.")</EmptyState>
                        }
                        @foreach (var build in builds)
                        {
                            <CharacterBuildCard @key="build.Character" Character="build" LeagueSlug="@league" WantedItem="@State.Filter.Item"
                                                Expanded="@(builds.Count == 1)" />
                        }
                        <p class="hint market-notes">
                            Sample: the first characters poe.ninja lists for this selection (highest level first), cached 6 hours. Uniques whose base the simulator does not know are
                            listed by name only.
                        </p>
                    }
                }
                else if (_job == null)
                {
                    <EmptyState Icon="⚒" Hint="Pick a main skill or ascendancy on the left to see what that build crafts, or analyse all builds.">Not analysed yet</EmptyState>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private static readonly int[] SampleSizes = { 20, 40, 60, 100 };
    private const int TopBuildCount = 20;

    /// <summary>Filter the page by a build clicked in the analysis (main skill plus ascendancy).</summary>
    private Task SelectBuild(NamedCount build) =>
        SetFilter(State.Filter with { Skill = build.Type is { Length: > 0 } ? build.Name : State.Filter.Skill, Class = build.Type ?? build.Name });

    /// <summary>A build matches the search by character name, ascendancy, a skill or a piece it wears.</summary>
    private bool MatchesBuild(SampledCharacter build) => TextSearch.Matches(State.CharacterSearch,
        build.Skills.Concat(build.Gear.Select(g => g.Title)).Concat(new[] { build.Character.Name, build.Class }));

    /// <summary>An item class card matches the search when its class or one of its bases does ("ring", "mnemonic").</summary>
    private bool Matches(ItemClassDemand demand) =>
        TextSearch.Matches(State.ClassSearch, demand.Bases.Select(b => b.Name).Prepend(demand.ItemClass));

    /// <summary>The most played builds as share entries: main skill with its ascendancy as the type.</summary>
    private static List<NamedCount> TopBuilds(BuildOverview overview) =>
        overview.TopBuilds.Select(b => new NamedCount(b.Skill, b.Count, b.Class)).ToList();

    /// <summary>Copies of the filtered item shown before the rest is folded away.</summary>
    private const int WantedLimit = 3;

    private BuildAnalysisJob? _job;
    private bool _allWanted;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // back on the page: everything is still in the per-user state, only the analysis job is attached again
        if (State.Overview != null)
        {
            AttachJob();
            return;
        }
        await Load(async () =>
        {
            State.Snapshots = await Ninja.SnapshotsAsync();
            State.Snapshot ??= State.Snapshots.FirstOrDefault();
        });
        await Search();
    }

    private async Task SelectLeague(string? url)
    {
        State.Snapshot = State.Snapshots.FirstOrDefault(s => s.Url == url) ?? State.Snapshot;
        State.Filter = BuildFilter.None;
        await Search();
    }

    private async Task SetFilter(BuildFilter filter)
    {
        State.Filter = filter;
        await Search();
    }

    private void SetSampleSize(string? value)
    {
        if (int.TryParse(value, out var size)) State.SampleSize = size;
        AttachJob();
    }

    private void ToggleClass(string itemClass, bool open)
    {
        if (open) State.ExpandedClasses.Add(itemClass);
        else State.ExpandedClasses.Remove(itemClass);
    }

    private async Task Search()
    {
        if (State.Snapshot is not { } snapshot) return;
        AttachJob();
        await Load(async () => State.Overview = await Ninja.SearchAsync(snapshot, State.Filter));
    }

    /// <summary>Run a load with a spinner; network problems become a message instead of a broken circuit.</summary>
    private async Task Load(Func<Task> load)
    {
        _loading = true;
        _error = null;
        try
        {
            await load();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or FormatException or System.Text.Json.JsonException)
        {
            _error = $"poe.ninja: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartAnalysis()
    {
        if (State.Snapshot == null) return;
        Watch(Ninja.Analyse(State.Snapshot, State.Filter, State.SampleSize));
    }

    /// <summary>Show the analysis already started for the current league, filter and sample size (if any).</summary>
    private void AttachJob() => Watch(State.Snapshot == null ? null : Ninja.ExistingAnalysis(State.Snapshot, State.Filter, State.SampleSize));

    private void Watch(BuildAnalysisJob? job)
    {
        if (_job != null) _job.Changed -= OnJobChanged;
        _job = job;
        if (_job != null) _job.Changed += OnJobChanged;
    }

    private void OnJobChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Watch(null);
}
